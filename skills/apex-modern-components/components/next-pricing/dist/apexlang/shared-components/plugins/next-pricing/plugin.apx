plugin nextPricing (
    name: Next Pricing
    staticId: AMC_NEXT_PRICING
    type: templateComponent
    templateComponent {
        availableAs: [
            partial
            report
        ]
        partial:
            ```html
            <div class="amc-NPricing amc-NPricing--#STYLE#{case HIGHLIGHT/}{when Y/} is-featured{endcase/}">
              <div class="amc-NPricing-card"{case STYLE/}{when spotlight/} data-amc-pointer="spot"{when holoPremium/} data-amc-pointer="holo"{when tilt3d/} data-amc-pointer="tilt"{otherwise/}{endcase/}>
                {case STYLE/}{when beamFeatured/}<span class="amc-NPricing-beam" aria-hidden="true"></span>{when spotlight/}<span class="amc-NPricing-spot" aria-hidden="true"></span>{when holoPremium/}<span class="amc-NPricing-foil" aria-hidden="true"></span>{when auroraDark/}<span class="amc-NPricing-aurora" aria-hidden="true"></span>{when tilt3d/}<span class="amc-NPricing-glare" aria-hidden="true"></span>{otherwise/}{endcase/}
                <div class="amc-NPricing-top">
                  <div class="amc-NPricing-head">
                    {if ?ICON/}<span class="amc-NPricing-icon" aria-hidden="true"><span class="fa #ICON#"></span></span>{endif/}
                    <h3 class="amc-NPricing-plan">#PLAN#</h3>
                    {if ?BADGE/}<span class="amc-NPricing-badge">#BADGE#</span>{endif/}
                  </div>
                  {if ?DESCRIPTION/}<p class="amc-NPricing-desc">#DESCRIPTION#</p>{endif/}
                  {case STYLE/}{when flipAnnual/}<div class="amc-NPricing-flip" tabindex="0" role="group">
                    <div class="amc-NPricing-flipInner">
                      <div class="amc-NPricing-side amc-NPricing-side--month">
                        <p class="amc-NPricing-price">{if ?CURRENCY/}<span class="amc-NPricing-currency">#CURRENCY#</span>{endif/}<span class="amc-NPricing-amount">#PRICE#</span>{if ?PERIOD/}<span class="amc-NPricing-period">#PERIOD#</span>{endif/}</p>
                        {if ?ANNUAL_PRICE/}<span class="amc-NPricing-flipHint" aria-hidden="true"><span class="fa fa-refresh"></span>{if ?SAVINGS/}<span class="amc-NPricing-flipHintText">#SAVINGS#</span>{endif/}</span>{endif/}
                      </div>
                      {if ?ANNUAL_PRICE/}<div class="amc-NPricing-side amc-NPricing-side--year">
                        <p class="amc-NPricing-price">{if ?CURRENCY/}<span class="amc-NPricing-currency">#CURRENCY#</span>{endif/}<span class="amc-NPricing-amount">#ANNUAL_PRICE#</span><span class="amc-NPricing-period">{if ?ANNUAL_PERIOD/}#ANNUAL_PERIOD#{else/}/ year{endif/}</span></p>
                        {if ?SAVINGS/}<span class="amc-NPricing-save">#SAVINGS#</span>{endif/}
                      </div>{endif/}
                    </div>
                  </div>{otherwise/}<p class="amc-NPricing-price">{if ?CURRENCY/}<span class="amc-NPricing-currency">#CURRENCY#</span>{endif/}<span class="amc-NPricing-amount">#PRICE#</span>{if ?PERIOD/}<span class="amc-NPricing-period">#PERIOD#</span>{endif/}</p>{endcase/}
                </div>
                <div class="amc-NPricing-body">
                  {if ?FEATURES/}<div class="amc-NPricing-features">#FEATURES#</div>{endif/}
                  {if ?CTA_LABEL/}<div class="amc-NPricing-action">{if ?CTA_URL/}<a class="t-Button{case HIGHLIGHT/}{when Y/} t-Button--hot{endcase/} amc-NPricing-cta" href="#CTA_URL#">{else/}<button class="t-Button{case HIGHLIGHT/}{when Y/} t-Button--hot{endcase/} amc-NPricing-cta" type="button">{endif/}<span class="t-Button-label">#CTA_LABEL#</span>{if ?CTA_URL/}</a>{else/}</button>{endif/}</div>{endif/}
                </div>
              </div>
            </div>
            ```
        reportBody:
            ```html
            <div class="amc-NPricings-frame"><ul class="amc-NPricings amc-NPricings--#STYLE#">#APEX$ROWS#</ul></div>
            ```
        reportRow:
            ```html
            <li class="amc-NPricings-item{case HIGHLIGHT/}{when Y/} is-featured{endcase/}">#APEX$PARTIAL#</li>
            ```
        translateTemplates: true
        defaultEscapeMode: html
    }
    advanced {
        filePrefix: #PLUGIN_FILES#
        quickPick: false
        substituteAttributeValues: true
        deprecated: false
        legacy: false
    }
    css {
        fileUrls: [
            #PLUGIN_FILES#amc-next-pricing.css
        ]
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#amc-next-pricing.js
        ]
    }
    information {
        version: 1.0.0
        helpText:
            ```
            Pick a Style, then map Plan, Price, Currency, Period, Description and Features (separated by |). CTA Label and CTA URL add a native Universal Theme button. Highlight = Y marks the recommended plan; Beam Featured, Holo Premium and Tilt 3D give it their strongest treatment. Flip Annual also uses Annual Price, Annual Period and Savings. Every style is complete without JavaScript; the runtime file only builds the feature lists and adds the pointer spotlight and tilt.
            ```
    }
    customAttribute STYLE (
        apexlangName: style
        attribute: 1
        name: Style
        scope: component
        type: selectList
        appearance {
            sequence: 10
        }
        componentLov {
            type: static
        }
        validation {
            required: true
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: beamFeatured
        }
        help {
            helpText:
                ```
                The pricing design, grouped by direction. Motion - Beam Featured: the highlighted plan has a travelling border beam and a glow. Motion - Spotlight: a pointer spotlight lights the borders of all plan cards at once. Depth - Tilt 3D: plans tilt toward the pointer, the price floats on its own layer and the highlighted plan stands forward. Depth - Flip Annual: the price slab flips on hover or focus to show Annual Price and Savings. Bold - Neo Brutal: ink borders, hard shadows, sticker badge. Bold - Clay: soft pillowy plans with clay check bubbles. Bold - Holo Premium: the highlighted plan becomes a holographic foil card. Bold - Aurora Dark: night cards with an aurora glow and grain. Smart - Expand Features: compact plans show three features and open the full list on hover or focus. Smart - Comparison Adaptive: cards when the region is wide, aligned comparison rows when it is narrow. Under reduced motion every effect stops and the static design stays.
                ```
        }
        entry beamFeatured (
            sequence: 10
            display: Beam Featured - motion
            return: beamFeatured
        )
        entry spotlight (
            sequence: 20
            display: Spotlight - motion
            return: spotlight
        )
        entry tilt3d (
            sequence: 30
            display: Tilt 3D - depth
            return: tilt3d
        )
        entry flipAnnual (
            sequence: 40
            display: Flip Annual - depth
            return: flipAnnual
        )
        entry neoBrutal (
            sequence: 50
            display: Neo Brutal - bold
            return: neoBrutal
        )
        entry clay (
            sequence: 60
            display: Clay - bold
            return: clay
        )
        entry holoPremium (
            sequence: 70
            display: Holo Premium - bold
            return: holoPremium
        )
        entry auroraDark (
            sequence: 80
            display: Aurora Dark - bold
            return: auroraDark
        )
        entry expandFeatures (
            sequence: 90
            display: Expand Features - smart
            return: expandFeatures
        )
        entry comparisonAdaptive (
            sequence: 100
            display: Comparison Adaptive - smart
            return: comparisonAdaptive
        )
    )
    customAttribute PLAN (
        apexlangName: plan
        attribute: 2
        name: Plan
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 20
        }
        validation {
            required: true
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Plan name, for example Starter, Business or Enterprise.
                ```
        }
    )
    customAttribute PRICE (
        apexlangName: price
        attribute: 3
        name: Price
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 30
        }
        validation {
            required: true
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                The amount. Format it in SQL with the application's NLS settings, for example to_char(monthly_fee, 'FML999G990'). Text such as Custom also works.
                ```
        }
    )
    customAttribute CURRENCY (
        apexlangName: currency
        attribute: 4
        name: Currency
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 40
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Currency symbol or code shown before the amount, for example SAR, USD or $. Leave empty for text prices such as Custom.
                ```
        }
    )
    customAttribute PERIOD (
        apexlangName: period
        attribute: 5
        name: Period
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 50
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Billing period shown after the amount, for example / month or per user / month.
                ```
        }
    )
    customAttribute DESCRIPTION (
        apexlangName: description
        attribute: 6
        name: Description
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 60
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                One short sentence about who the plan is for.
                ```
        }
    )
    customAttribute FEATURES (
        apexlangName: features
        attribute: 7
        name: Features
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 70
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Features separated by |, for example 5 users|Unlimited orders|Email support. The runtime file turns them into a check list; Expand Features shows the first three and opens the rest on hover or focus. Without JavaScript the plain text stays visible.
                ```
        }
    )
    customAttribute CTA_LABEL (
        apexlangName: ctaLabel
        attribute: 8
        name: CTA Label
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 80
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Call to action label, for example Start free trial or Contact sales. Leave empty to hide the button.
                ```
        }
    )
    customAttribute CTA_URL (
        apexlangName: ctaUrl
        attribute: 9
        name: CTA URL
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 90
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Target URL of the call to action, for example f?p=&APP_ID.:20:&SESSION.::NO::P20_PLAN:BUSINESS. Must be a developer-controlled value, never raw user input. Without a URL the call to action renders as a button for Dynamic Actions.
                ```
        }
    )
    customAttribute BADGE (
        apexlangName: badge
        attribute: 10
        name: Badge
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 100
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional short badge, for example Most popular or Best value.
                ```
        }
    )
    customAttribute HIGHLIGHT (
        apexlangName: highlight
        attribute: 11
        name: Highlight
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 110
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Y marks the recommended plan and makes its button the hot button. Any other value, or empty, renders a normal plan.
                ```
        }
    )
    customAttribute ANNUAL_PRICE (
        apexlangName: annualPrice
        attribute: 12
        name: Annual Price
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 120
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Flip Annual style: the price when billed yearly, formatted in SQL like Price, for example 4,690. Leave empty to show only the monthly price.
                ```
        }
    )
    customAttribute ANNUAL_PERIOD (
        apexlangName: annualPeriod
        attribute: 13
        name: Annual Period
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 130
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Flip Annual style: period text for Annual Price, for example / year. Defaults to / year.
                ```
        }
    )
    customAttribute SAVINGS (
        apexlangName: savings
        attribute: 14
        name: Savings
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 140
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Flip Annual style: saving text for yearly billing, for example Save 20% or 2 months free. Shown on the front as a hint and on the back beside the annual price.
                ```
        }
    )
    customAttribute ICON (
        apexlangName: icon
        attribute: 15
        name: Icon
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 150
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Optional Font APEX icon class for the plan, for example fa-rocket. Shown beside the plan name.
                ```
        }
    )
    file "amc-next-pricing.css" (
        fileName: amc-next-pricing.css
        mimeType: text/css
        charSet: utf-8
    )
    file "amc-next-pricing.js" (
        fileName: amc-next-pricing.js
        mimeType: application/javascript
        charSet: utf-8
    )
)
