plugin motionText (
    name: Motion Text
    staticId: AMC_MOTION_TEXT
    type: templateComponent
    templateComponent {
        availableAs: [
            partial
        ]
        partial:
            ```html
            <div class="amc-Motion amc-Motion--text{if ?SIZE/} amc-Motion--#SIZE#{endif/}{if ALIGN_START/} amc-Motion--start{endif/}" data-amc-text="#EFFECT#">
              <div class="amc-Motion-inner">{case EFFECT/}
              {when wave/}<span class="amc-tx-wave" data-amc-split="letters">#TEXT#</span>
              {when flip/}<span class="amc-tx-flip" data-amc-split="letters">#TEXT#</span>
              {when glitch/}<span class="amc-tx-glitch" data-text="#TEXT!ATTR#">#TEXT#</span>
              {when reveal/}<p class="amc-tx-reveal" data-amc-split="words">#TEXT#</p>
              {when typewriter/}<span class="amc-tx-type" data-amc-phrases="#TEXT!ATTR#"><span class="amc-tx-text">#TEXT#</span><span class="amc-caret" aria-hidden="true"></span></span>
              {when scramble/}<span class="amc-tx-scr" data-amc-phrases="#TEXT!ATTR#">#TEXT#</span>
              {otherwise/}<span>#TEXT#</span>
              {endcase/}</div>
            </div>
            ```
        translateTemplates: false
        defaultEscapeMode: html
    }
    advanced {
        filePrefix: #PLUGIN_FILES#
        quickPick: false
        substituteAttributeValues: true
        deprecated: false
        legacy: false
    }
    css {
        fileUrls: [
            #PLUGIN_FILES#amc-motion-text.css
        ]
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#amc-motion-text.js
        ]
    }
    information {
        version: 1.0.1
        helpText:
            ```
            For Typewriter and Scramble, separate several phrases with |, for example Welcome back|Your orders are ready. Screen readers get the plain text; users with reduced motion see it without animation.
            ```
    }
    customAttribute TEXT (
        apexlangName: text
        attribute: 1
        name: Text
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 10
        }
        validation {
            required: true
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                The text to animate. Static text, &ITEM. substitution or a column.
                ```
        }
    )
    customAttribute EFFECT (
        apexlangName: effect
        attribute: 2
        name: Effect
        scope: component
        type: selectList
        appearance {
            sequence: 20
        }
        componentLov {
            type: static
        }
        validation {
            required: true
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: wave
        }
        help {
            helpText:
                ```
                The text animation.
                ```
        }
        entry wave (
            sequence: 10
            display: Wave letters
            return: wave
        )
        entry glitch (
            sequence: 20
            display: Glitch
            return: glitch
        )
        entry reveal (
            sequence: 30
            display: Masked word reveal
            return: reveal
        )
        entry flip (
            sequence: 40
            display: 3D letter flip
            return: flip
        )
        entry typewriter (
            sequence: 50
            display: Typewriter
            return: typewriter
        )
        entry scramble (
            sequence: 60
            display: Decode scramble
            return: scramble
        )
    )
    customAttribute SIZE (
        apexlangName: size
        attribute: 3
        name: Size
        scope: component
        type: selectList
        appearance {
            sequence: 30
        }
        componentLov {
            type: static
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Leave empty for the medium size.
                ```
        }
        entry small (
            sequence: 10
            display: Small
            return: sm
        )
        entry large (
            sequence: 20
            display: Large
            return: lg
        )
        entry extraLarge (
            sequence: 30
            display: Extra large
            return: xl
        )
    )
    customAttribute ALIGN_START (
        apexlangName: alignStart
        attribute: 4
        name: Align to Start
        scope: component
        type: yesNo
        appearance {
            sequence: 40
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: false
        }
        help {
            helpText:
                ```
                Align the text to the start edge instead of centering it.
                ```
        }
    )
    file "amc-motion-text.css" (
        fileName: amc-motion-text.css
        mimeType: text/css
        charSet: utf-8
    )
    file "amc-motion-text.js" (
        fileName: amc-motion-text.js
        mimeType: application/javascript
        charSet: utf-8
    )
)
