plugin progressSteps (
    name: Progress Steps
    staticId: AMC_PROGRESS_STEPS
    type: templateComponent
    templateComponent {
        availableAs: [
            report
        ]
        partial:
            ```html
            <span class="amc-Steps-marker" aria-hidden="true"><span class="amc-Steps-icon fa {case STATUS/}{when complete/}fa-check{when error/}fa-exclamation{otherwise/}{endcase/}"></span></span>
            <span class="amc-Steps-content">
              <span class="amc-Steps-title">#TITLE#</span>
              <span class="amc-u-srOnly">{case STATUS/}{when complete/}Completed{when current/}Current step{when error/}Needs attention{otherwise/}Not started{endcase/}</span>
              {if ?DESCRIPTION/}<span class="amc-Steps-desc">#DESCRIPTION#</span>{endif/}
            </span>
            ```
        reportBody:
            ```html
            <ol class="amc-Steps amc-Steps--#ORIENTATION#">#APEX$ROWS#</ol>
            ```
        reportRow:
            ```html
            <li class="amc-Steps-item {case STATUS/}{when complete/}amc-Steps-item--complete{when current/}amc-Steps-item--current{when error/}amc-Steps-item--error{otherwise/}amc-Steps-item--upcoming{endcase/}"{case STATUS/}{when current/} aria-current="step"{endcase/}>#APEX$PARTIAL#</li>
            ```
        translateTemplates: true
        defaultEscapeMode: html
    }
    advanced {
        filePrefix: #PLUGIN_FILES#
        quickPick: false
        substituteAttributeValues: true
        deprecated: false
        legacy: false
    }
    css {
        fileUrls: [
            #PLUGIN_FILES#amc-progress-steps.css
        ]
    }
    information {
        version: 1.0.1
        helpText:
            ```
            Each query row is one step. Map Status to a column returning complete, current, upcoming or error. Steps are numbered automatically and the current step is announced to screen readers.
            ```
    }
    customAttribute TITLE (
        apexlangName: title
        attribute: 1
        name: Title
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 10
        }
        validation {
            required: true
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Step name, for example Manager Approval.
                ```
        }
    )
    customAttribute DESCRIPTION (
        apexlangName: description
        attribute: 2
        name: Description
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 20
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional secondary text such as a date or the responsible person.
                ```
        }
    )
    customAttribute STATUS (
        apexlangName: status
        attribute: 3
        name: Status
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 30
        }
        validation {
            required: true
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                One of complete, current, upcoming or error. Unknown values render as upcoming.
                ```
        }
    )
    customAttribute ORIENTATION (
        apexlangName: orientation
        attribute: 4
        name: Orientation
        scope: component
        type: selectList
        appearance {
            sequence: 40
        }
        componentLov {
            type: static
        }
        validation {
            required: true
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: horizontal
        }
        help {
            helpText:
                ```
                Horizontal steps switch to vertical automatically on narrow screens.
                ```
        }
        entry horizontal (
            sequence: 10
            display: Horizontal
            return: horizontal
        )
        entry vertical (
            sequence: 20
            display: Vertical
            return: vertical
        )
    )
    file "amc-progress-steps.css" (
        fileName: amc-progress-steps.css
        mimeType: text/css
        charSet: utf-8
    )
)
