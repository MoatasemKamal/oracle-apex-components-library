plugin nextDocument (
    name: Next Document
    staticId: AMC_NEXT_DOCUMENT
    type: templateComponent
    templateComponent {
        availableAs: [
            report
        ]
        partial:
            ```html
            <dl class="amc-NDocument-head">
              {if ?ISSUER_NAME/}<div class="amc-NDocument-hf"><dt>From</dt><dd data-f="issuerName">#ISSUER_NAME#</dd></div>{endif/}
              {if ?ISSUER_DETAILS/}<div class="amc-NDocument-hf amc-NDocument-hf--quiet"><dt>Issuer details</dt><dd data-f="issuerDetails">#ISSUER_DETAILS#</dd></div>{endif/}
              {if ?ISSUER_VAT/}<div class="amc-NDocument-hf amc-NDocument-hf--quiet"><dt>Issuer VAT number</dt><dd data-f="issuerVat">#ISSUER_VAT#</dd></div>{endif/}
              {if ?DOC_TYPE/}<div class="amc-NDocument-hf"><dt>Document</dt><dd data-f="docType">#DOC_TYPE#</dd></div>{endif/}
              {if ?DOC_NUMBER/}<div class="amc-NDocument-hf"><dt>Number</dt><dd data-f="docNumber">#DOC_NUMBER#</dd></div>{endif/}
              {if ?DOC_DATE/}<div class="amc-NDocument-hf"><dt>Date</dt><dd data-f="docDate">#DOC_DATE#</dd></div>{endif/}
              {if ?DUE_DATE/}<div class="amc-NDocument-hf"><dt>Due</dt><dd data-f="dueDate">#DUE_DATE#</dd></div>{endif/}
              {if ?PARTY_NAME/}<div class="amc-NDocument-hf"><dt>To</dt><dd data-f="partyName">#PARTY_NAME#</dd></div>{endif/}
              {if ?PARTY_ADDRESS/}<div class="amc-NDocument-hf amc-NDocument-hf--quiet"><dt>Address</dt><dd data-f="partyAddress">#PARTY_ADDRESS#</dd></div>{endif/}
              {if ?VAT_NUMBER/}<div class="amc-NDocument-hf amc-NDocument-hf--quiet"><dt>VAT number</dt><dd data-f="vatNumber">#VAT_NUMBER#</dd></div>{endif/}
              {if ?CURRENCY/}<div class="amc-NDocument-hf"><dt>Currency</dt><dd data-f="currency">#CURRENCY#</dd></div>{endif/}
              {if ?STATUS/}<div class="amc-NDocument-hf"><dt>Status</dt><dd data-f="status">#STATUS#</dd></div>{endif/}
              {if ?NOTES/}<div class="amc-NDocument-hf amc-NDocument-hf--quiet"><dt>Notes</dt><dd data-f="notes">#NOTES#</dd></div>{endif/}
              {if ?QR_IMAGE_URL/}<div class="amc-NDocument-hf" hidden><dt>QR</dt><dd data-f="qr" data-src="#QR_IMAGE_URL!ATTR#"></dd></div>{endif/}
            </dl>
            <div class="amc-NDocument-srcLine">
              <span class="amc-NDocument-srcDesc" data-f="desc">#LINE_DESC#</span>
              <span class="amc-NDocument-srcNums">{if ?QTY/}<span data-f="qty">#QTY#</span> x {endif/}{if ?UNIT_PRICE/}<span data-f="price">#UNIT_PRICE#</span>{endif/}{if ?DISCOUNT/} - <span data-f="discount">#DISCOUNT#</span>{endif/}{if ?TAX_RATE/} <span class="amc-NDocument-srcRate">VAT <span data-f="rate">#TAX_RATE#</span>%</span>{endif/}{if ?LINE_TOTAL/} = <span data-f="total">#LINE_TOTAL#</span>{endif/}</span>
            </div>
            ```
        reportBody:
            ```html
            <div class="amc-NDocument amc-NDocument--#STYLE#" data-variant="#STYLE#" data-tax-rate="#DEFAULT_TAX_RATE#" data-words="#AMOUNT_IN_WORDS#" data-bilingual="#BILINGUAL#" data-print="#SHOW_PRINT#">
              <span class="amc-NDocument-i18n" hidden data-from="From" data-bill-to="Bill to" data-supplier="Supplier" data-employee="Employee" data-issued="Issue date" data-due="Due date" data-valid="Valid until" data-pay-date="Pay date" data-vat-no="VAT number" data-currency="Currency" data-no="No." data-desc="Description" data-qty="Qty" data-unit="Unit price" data-disc="Discount" data-rate="VAT rate" data-vat-amount="VAT amount" data-amount="Amount" data-taxable="Taxable amount" data-incl="Total incl. VAT" data-subtotal="Subtotal" data-discount="Discount" data-vat="VAT" data-total="Total" data-total-due="Total due" data-total-paid="Total paid" data-words="Amount in words" data-notes="Notes" data-print="Print document" data-earnings="Earnings" data-deductions="Deductions" data-gross="Gross pay" data-total-deductions="Total deductions" data-net="Net pay" data-split="How gross pay splits" data-due-in="Due %0" data-overdue="Overdue by %0" data-status="Status" data-paid="Paid" data-st-overdue="Overdue" data-draft="Draft" data-void="Void" data-sent="Sent" data-approved="Approved" data-items="Line items" data-qr="E-invoice QR code" data-thanks="Thank you"></span>
              <ol class="amc-NDocument-source">#APEX$ROWS#</ol>
            </div>
            ```
        reportRow:
            ```html
            <li class="amc-NDocument-row">#APEX$PARTIAL#</li>
            ```
        translateTemplates: true
        defaultEscapeMode: html
    }
    advanced {
        filePrefix: #PLUGIN_FILES#
        quickPick: false
        substituteAttributeValues: true
        deprecated: false
        legacy: false
    }
    css {
        fileUrls: [
            #PLUGIN_FILES#amc-next-document.css
        ]
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#amc-next-document.js
        ]
    }
    information {
        version: 1.0.0
        helpText:
            ```
            One query row per line. Map Line Description plus Quantity and Unit Price, or Line Total. Header fields (Document Type, Number, dates, Party, VAT Number, Currency, Status, Notes, Issuer) are read from the first row that has them, so repeat them on every row with a join or map them to page items. Numbers are plain numbers with a period as the decimal separator. Dates are ISO text, TO_CHAR(col, 'YYYY-MM-DD'). Status paid, overdue, draft, void, sent or approved prints a stamp. Without JavaScript the lines render as a readable list.
            ```
    }
    customAttribute STYLE (
        apexlangName: style
        attribute: 1
        name: Style
        scope: component
        type: selectList
        appearance {
            sequence: 10
        }
        componentLov {
            type: static
        }
        validation {
            required: true
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: classicInvoice
        }
        help {
            helpText:
                ```
                Document design; the direction is given after the name. classicInvoice - bold: an A4 sheet on the page with ledger rules, a single rule above the subtotal, a double rule under the total and an inked rubber stamp for the status. modernMinimal - smart: no table grid; when the region is wide the dates and party sit in a rail beside the lines, when narrow the total moves to the top; the due date is counted in days. bilingualTax - smart: ZATCA-style tax invoice with every label in English and Arabic, seller and buyer VAT numbers, per-line VAT amount and total including VAT, Hijri date and an optional QR image. thermalReceipt - depth: an 80 mm paper strip with torn edges lifted off the page, dotted leaders and a centred total; prints on 80 mm paper. payslip - motion: earnings and deductions side by side, gross, deductions and net pay, and a pay split bar that settles once; VAT is ignored. Under reduced motion the stamp and the bar appear without movement.
                ```
        }
        entry classicInvoice (
            sequence: 10
            display: Classic Invoice - bold
            return: classicInvoice
        )
        entry modernMinimal (
            sequence: 20
            display: Modern Minimal - smart
            return: modernMinimal
        )
        entry bilingualTax (
            sequence: 30
            display: Bilingual Tax Invoice - smart
            return: bilingualTax
        )
        entry thermalReceipt (
            sequence: 40
            display: Thermal Receipt - depth
            return: thermalReceipt
        )
        entry payslip (
            sequence: 50
            display: Payslip - motion
            return: payslip
        )
    )
    customAttribute DOC_TYPE (
        apexlangName: docType
        attribute: 2
        name: Document Type
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 20
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Document title in sentence case, for example Tax invoice, Quotation, Purchase order, Receipt or Payslip for September 2026. For a bilingual title give both parts separated by |, for example Tax invoice|فاتورة ضريبية; otherwise the common types get their Arabic title automatically in bilingual layouts.
                ```
        }
    )
    customAttribute DOC_NUMBER (
        apexlangName: docNumber
        attribute: 3
        name: Document Number
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 30
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Document reference, for example INV-2026-0418, QT-1187 or PO-40912. Repeated on every row; the first non-empty value is used.
                ```
        }
    )
    customAttribute DOC_DATE (
        apexlangName: docDate
        attribute: 4
        name: Document Date
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 40
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Issue date as ISO text, TO_CHAR(invoice_date, 'YYYY-MM-DD'). It is formatted with Intl in the page language; any other text is shown as it is.
                ```
        }
    )
    customAttribute DUE_DATE (
        apexlangName: dueDate
        attribute: 5
        name: Due Date
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 50
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional due or valid-until date in the same ISO form. Modern Minimal also says how many days remain or have passed. For a payslip use it for the pay date.
                ```
        }
    )
    customAttribute PARTY_NAME (
        apexlangName: partyName
        attribute: 6
        name: Party Name
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 60
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                The customer, supplier or employee the document is addressed to, for example Al Noor Medical Supplies Co.
                ```
        }
    )
    customAttribute PARTY_ADDRESS (
        apexlangName: partyAddress
        attribute: 7
        name: Party Address
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 70
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Address lines separated by |, for example King Fahd Road|Al Olaya, Riyadh 12211. For a payslip use it for employee number, job title and department.
                ```
        }
    )
    customAttribute VAT_NUMBER (
        apexlangName: vatNumber
        attribute: 8
        name: Party VAT Number
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 80
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                The party's VAT registration number, for example 310122393500003. Shown under the party name; required on a standard tax invoice.
                ```
        }
    )
    customAttribute CURRENCY (
        apexlangName: currency
        attribute: 9
        name: Currency
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 90
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                ISO 4217 code such as SAR, AED, KWD or USD. It sets the number of decimals (KWD, BHD and OMR use three) and the words in the amount in words. Defaults to SAR.
                ```
        }
    )
    customAttribute STATUS (
        apexlangName: status
        attribute: 10
        name: Status
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 100
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                One of paid, overdue, draft, void, sent or approved (any case). It is printed as a rubber stamp and announced to screen readers. Any other value, or empty, shows no stamp.
                ```
        }
    )
    customAttribute NOTES (
        apexlangName: notes
        attribute: 11
        name: Notes
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 110
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional terms or payment instructions, lines separated by |, for example Payment within 30 days|IBAN SA03 8000 0000 6080 1016 7519.
                ```
        }
    )
    customAttribute LINE_DESC (
        apexlangName: lineDesc
        attribute: 12
        name: Line Description
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 120
        }
        validation {
            required: true
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                What the line is for, for example Nitrile examination gloves, box of 100, or Housing allowance. A second line of detail may follow a |.
                ```
        }
    )
    customAttribute QTY (
        apexlangName: qty
        attribute: 13
        name: Quantity
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 130
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Quantity as a plain number, for example 40 or 2.5. Defaults to 1 when Unit Price is given.
                ```
        }
    )
    customAttribute UNIT_PRICE (
        apexlangName: unitPrice
        attribute: 14
        name: Unit Price
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 140
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Price per unit before VAT as a plain number with a period as the decimal separator, for example 18.50. For payslip deductions return a negative amount.
                ```
        }
    )
    customAttribute DISCOUNT (
        apexlangName: discount
        attribute: 15
        name: Discount
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 150
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional line discount: an amount such as 120 or a percentage of Quantity x Unit Price such as 10%.
                ```
        }
    )
    customAttribute TAX_RATE (
        apexlangName: taxRate
        attribute: 16
        name: VAT Rate
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 160
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional VAT percentage for the line, for example 15 or 0 for zero-rated and exempt lines. Empty uses Default VAT Rate. Lines with different rates get one VAT row per rate.
                ```
        }
    )
    customAttribute LINE_TOTAL (
        apexlangName: lineTotal
        attribute: 17
        name: Line Total
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 170
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional net line amount before VAT. When given it wins over Quantity x Unit Price - Discount (a console warning names lines that differ by more than one minor unit). Use it for lines that have no quantity, such as payslip earnings and deductions.
                ```
        }
    )
    customAttribute ISSUER_NAME (
        apexlangName: issuerName
        attribute: 18
        name: Issuer Name
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 180
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Your company as it appears on the document, for example Tamkeen Trading Est. For a bilingual name use English|Arabic.
                ```
        }
    )
    customAttribute ISSUER_DETAILS (
        apexlangName: issuerDetails
        attribute: 19
        name: Issuer Details
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 190
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Issuer address and registration lines separated by |, for example Prince Sultan Street, Jeddah 23615|CR 4030285741.
                ```
        }
    )
    customAttribute ISSUER_VAT (
        apexlangName: issuerVat
        attribute: 20
        name: Issuer VAT Number
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 200
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Your VAT registration number, for example 300475812600003. Required on tax invoices.
                ```
        }
    )
    customAttribute DEFAULT_TAX_RATE (
        apexlangName: defaultTaxRate
        attribute: 21
        name: Default VAT Rate
        scope: component
        type: number
        appearance {
            sequence: 210
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: 15
        }
        help {
            helpText:
                ```
                VAT percentage used for lines without a VAT Rate, for example 15 for Saudi Arabia or 5 for the UAE. Use 0 for documents without VAT. The payslip style always ignores VAT.
                ```
        }
    )
    customAttribute AMOUNT_IN_WORDS (
        apexlangName: amountInWords
        attribute: 22
        name: Amount in Words
        scope: component
        type: selectList
        appearance {
            sequence: 220
        }
        componentLov {
            type: static
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: english
        }
        help {
            helpText:
                ```
                Writes the total (net pay on a payslip) in words under the totals. english, arabic (tafqit, for example فقط ... ريال سعودي لا غير), both, or none. Currency names are known for SAR, AED, QAR, KWD, BHD, OMR, USD and EUR; other codes are written after the number.
                ```
        }
        entry english (
            sequence: 10
            display: English
            return: english
        )
        entry arabic (
            sequence: 20
            display: Arabic
            return: arabic
        )
        entry both (
            sequence: 30
            display: English and Arabic
            return: both
        )
        entry none (
            sequence: 40
            display: None
            return: none
        )
    )
    customAttribute BILINGUAL (
        apexlangName: bilingual
        attribute: 23
        name: Bilingual Labels
        scope: component
        type: yesNo
        appearance {
            sequence: 230
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: false
        }
        help {
            helpText:
                ```
                Y adds the Arabic label beside every English label, as Gulf tax invoices require. The Bilingual Tax Invoice style is always bilingual. The layout mirrors itself on RTL pages.
                ```
        }
    )
    customAttribute QR_IMAGE_URL (
        apexlangName: qrImageUrl
        attribute: 24
        name: QR Image URL
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 240
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Optional image of the e-invoice QR code, for example a data URI built in SQL from APEX_BARCODE.GET_QRCODE_PNG, or a URL to a stored image. Shown by Bilingual Tax Invoice and Thermal Receipt. The value must be produced by the application, never taken from user input.
                ```
        }
    )
    customAttribute SHOW_PRINT (
        apexlangName: showPrint
        attribute: 25
        name: Show Print Button
        scope: component
        type: yesNo
        appearance {
            sequence: 250
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: true
        }
        help {
            helpText:
                ```
                Y adds a Print document button that prints only this document on A4 (80 mm for the receipt). Printing the whole page with the browser also uses the clean print layout.
                ```
        }
    )
    file "amc-next-document.css" (
        fileName: amc-next-document.css
        mimeType: text/css
        charSet: utf-8
    )
    file "amc-next-document.js" (
        fileName: amc-next-document.js
        mimeType: application/javascript
        charSet: utf-8
    )
)
