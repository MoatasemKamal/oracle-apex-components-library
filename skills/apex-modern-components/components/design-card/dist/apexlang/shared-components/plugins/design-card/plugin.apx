plugin designCard (
    name: Design Card
    staticId: AMC_DESIGN_CARD
    type: templateComponent
    templateComponent {
        availableAs: [
            partial
            report
        ]
        partial:
            ```html
            <div class="amc-DCard amc-DCard--#STYLE# {case STATE/}{when success/}amc-DCard--stateSuccess{when warning/}amc-DCard--stateWarning{when danger/}amc-DCard--stateDanger{when info/}amc-DCard--stateInfo{otherwise/}amc-DCard--stateNeutral{endcase/}">
              <article class="amc-DCard-card">
                {if ?IMAGE_URL/}<figure class="amc-DCard-media"><img class="amc-DCard-img" src="#IMAGE_URL#" width="640" height="360" alt="" loading="lazy"></figure>{endif/}
                {if ?ICON/}<span class="amc-DCard-icon" aria-hidden="true"><span class="amc-DCard-glyph fa #ICON#"></span></span>{endif/}
                <div class="amc-DCard-body">
                  <div class="amc-DCard-top">{if ?EYEBROW/}<p class="amc-DCard-eyebrow">#EYEBROW#</p>{endif/}{if ?BADGE/}<span class="amc-DCard-badge"><span class="amc-DCard-badgeDot" aria-hidden="true"></span>#BADGE#</span>{endif/}</div>
                  <h3 class="amc-DCard-title">{if ?LINK_URL/}<a class="amc-DCard-link" href="#LINK_URL#">#TITLE#</a>{else/}#TITLE#{endif/}</h3>
                  {if ?DESCRIPTION/}<p class="amc-DCard-desc">#DESCRIPTION#</p>{endif/}
                </div>
                <div class="amc-DCard-foot">{if ?VALUE/}<p class="amc-DCard-figure">{if ?VALUE_LABEL/}<span class="amc-DCard-valueLabel">#VALUE_LABEL#</span>{endif/}<span class="amc-DCard-value">#VALUE#</span></p>{endif/}{if ?META/}<span class="amc-DCard-meta">#META#</span>{endif/}{if ?LINK_URL/}{if ?LINK_LABEL/}<span class="amc-DCard-cta" aria-hidden="true">#LINK_LABEL#</span>{endif/}{endif/}</div>
              </article>
            </div>
            ```
        reportBody:
            ```html
            <ul class="amc-DCards amc-DCards--#STYLE#{case COLUMNS/}{when 2/} amc-DCards--cols2{when 3/} amc-DCards--cols3{when 4/} amc-DCards--cols4{otherwise/}{endcase/}">#APEX$ROWS#</ul>
            ```
        reportRow:
            ```html
            <li class="amc-DCards-item">#APEX$PARTIAL#</li>
            ```
        translateTemplates: true
        defaultEscapeMode: html
    }
    advanced {
        filePrefix: #PLUGIN_FILES#
        quickPick: false
        substituteAttributeValues: true
        deprecated: false
        legacy: false
    }
    css {
        fileUrls: [
            #PLUGIN_FILES#amc-design-card.css
        ]
    }
    information {
        version: 1.0.1
        helpText:
            ```
            Pick a Style, then map Title (required) and any of Eyebrow, Description, Icon, Image URL, Badge, State, Value, Value Label, Meta, Link URL and Link Label to columns or static text. Empty settings are simply left out. The whole card becomes clickable when Link URL is set. Colors follow the active Universal Theme style, including dark styles and Theme Roller changes.
            ```
    }
    customAttribute STYLE (
        apexlangName: style
        attribute: 1
        name: Style
        scope: component
        type: selectList
        appearance {
            sequence: 10
        }
        componentLov {
            type: static
        }
        validation {
            required: true
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: elevated
        }
        help {
            helpText:
                ```
                Card design. Elevated: soft shadow, no border. Outline: hairline border, no shadow. Glass: translucent frosted surface. Gradient Border: gradient frame in the theme primary color. Image Top: picture above the text. Image Overlay: text on top of the picture. Horizontal: picture or icon beside the text. Accent Top: thick top edge in the State color. Ticket: main part plus a perforated stub for Value. Stacked Paper: sheets peeking out behind the card. Soft Inset: recessed surface. Corner Icon: large icon in the top corner.
                ```
        }
        entry elevated (
            sequence: 10
            display: Elevated
            return: elevated
        )
        entry outline (
            sequence: 20
            display: Outline
            return: outline
        )
        entry glass (
            sequence: 30
            display: Glass
            return: glass
        )
        entry gradientBorder (
            sequence: 40
            display: Gradient Border
            return: gradientBorder
        )
        entry imageTop (
            sequence: 50
            display: Image Top
            return: imageTop
        )
        entry imageOverlay (
            sequence: 60
            display: Image Overlay
            return: imageOverlay
        )
        entry horizontal (
            sequence: 70
            display: Horizontal
            return: horizontal
        )
        entry accentTop (
            sequence: 80
            display: Accent Top
            return: accentTop
        )
        entry ticket (
            sequence: 90
            display: Ticket
            return: ticket
        )
        entry stackedPaper (
            sequence: 100
            display: Stacked Paper
            return: stackedPaper
        )
        entry softInset (
            sequence: 110
            display: Soft Inset
            return: softInset
        )
        entry cornerIcon (
            sequence: 120
            display: Corner Icon
            return: cornerIcon
        )
    )
    customAttribute TITLE (
        apexlangName: title
        attribute: 2
        name: Title
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 20
        }
        validation {
            required: true
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Card heading, for example the project or customer name. Rendered as an h3.
                ```
        }
    )
    customAttribute EYEBROW (
        apexlangName: eyebrow
        attribute: 3
        name: Eyebrow
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 30
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional short line above the title, for example an order number or category.
                ```
        }
    )
    customAttribute DESCRIPTION (
        apexlangName: description
        attribute: 4
        name: Description
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 40
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional body text of one to three sentences.
                ```
        }
    )
    customAttribute ICON (
        apexlangName: icon
        attribute: 5
        name: Icon
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 50
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Optional Font APEX icon class, for example fa-truck. Static text or a column. Image styles show it only when there is no image, except Image Top, which overlaps it on the picture.
                ```
        }
    )
    customAttribute IMAGE_URL (
        apexlangName: imageUrl
        attribute: 6
        name: Image URL
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 60
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Optional picture URL, used by the Image Top, Image Overlay and Horizontal styles. The URL must come from a developer-controlled source (a table you own or #APP_FILES#), never from free user input. The image is decorative (empty alt); put the meaning in the Title.
                ```
        }
    )
    customAttribute BADGE (
        apexlangName: badge
        attribute: 7
        name: Badge
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 70
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional status text shown as a small badge, for example Shipped or Overdue. Colored by State.
                ```
        }
    )
    customAttribute STATE (
        apexlangName: state
        attribute: 8
        name: State
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 80
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Semantic color of the badge and of the Accent Top edge: success, warning, danger, info or neutral. Any other value renders as neutral. Always pair it with Badge text so the state is not shown by color alone.
                ```
        }
    )
    customAttribute VALUE (
        apexlangName: value
        attribute: 9
        name: Value
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 90
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional key figure in the footer, for example an amount. Format it in SQL with the application's NLS settings. The Ticket style shows it in the stub.
                ```
        }
    )
    customAttribute VALUE_LABEL (
        apexlangName: valueLabel
        attribute: 10
        name: Value Label
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 100
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional caption for Value, for example Total or Budget.
                ```
        }
    )
    customAttribute META (
        apexlangName: meta
        attribute: 11
        name: Meta
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 110
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional small footer text, for example a due date or owner.
                ```
        }
    )
    customAttribute LINK_URL (
        apexlangName: linkUrl
        attribute: 12
        name: Link URL
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 120
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Optional target URL. When set, the title becomes a link that covers the whole card. Build it with apex_page.get_url in SQL; the value must be developer-controlled, never free user input.
                ```
        }
    )
    customAttribute LINK_LABEL (
        apexlangName: linkLabel
        attribute: 13
        name: Link Label
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 130
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional visible call to action shown in the footer when Link URL is set, for example View Order.
                ```
        }
    )
    customAttribute COLUMNS (
        apexlangName: columns
        attribute: 14
        name: Columns
        scope: component
        type: selectList
        appearance {
            sequence: 140
        }
        componentLov {
            type: static
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Report mode only. Empty fits as many cards as the region width allows. The fixed options are a maximum: columns drop automatically when a card would get too narrow.
                ```
        }
        entry two (
            sequence: 10
            display: Up to 2 Columns
            return: 2
        )
        entry three (
            sequence: 20
            display: Up to 3 Columns
            return: 3
        )
        entry four (
            sequence: 30
            display: Up to 4 Columns
            return: 4
        )
    )
    file "amc-design-card.css" (
        fileName: amc-design-card.css
        mimeType: text/css
        charSet: utf-8
    )
)
