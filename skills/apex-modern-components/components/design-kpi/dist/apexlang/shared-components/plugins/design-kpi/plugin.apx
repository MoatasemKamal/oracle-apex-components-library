plugin designKpi (
    name: Design KPI
    staticId: AMC_DESIGN_KPI
    type: templateComponent
    templateComponent {
        availableAs: [
            partial
            report
        ]
        partial:
            ```html
            <div class="amc-DKpi amc-DKpi--#STYLE# {case TREND/}{when up/}amc-DKpi--up{when down/}amc-DKpi--down{otherwise/}amc-DKpi--flat{endcase/}{if INVERT_TREND/} amc-DKpi--invert{endif/}">
              <div class="amc-DKpi-card">
                {case STYLE/}{when ring/}<div class="amc-DKpi-ring" data-percent="#PERCENT#">
                  <svg class="amc-DKpi-ringSvg" viewBox="0 0 40 40" aria-hidden="true" focusable="false"><circle class="amc-DKpi-ringTrack" cx="20" cy="20" r="16" pathLength="100"></circle><circle class="amc-DKpi-ringBar" cx="20" cy="20" r="16" pathLength="100"></circle></svg>
                  {if ?PERCENT/}<span class="amc-DKpi-ringText">#PERCENT#%</span>{endif/}
                </div>{when iconLeft/}{if ?ICON/}<span class="amc-DKpi-icon" aria-hidden="true"><span class="fa #ICON#"></span></span>{endif/}{when glass/}{if ?ICON/}<span class="amc-DKpi-icon" aria-hidden="true"><span class="fa #ICON#"></span></span>{endif/}{when gradient/}{if ?ICON/}<span class="amc-DKpi-icon" aria-hidden="true"><span class="fa #ICON#"></span></span>{endif/}{otherwise/}{endcase/}
                <h3 class="amc-DKpi-label">#LABEL#</h3>
                {case STYLE/}{when compare/}<dl class="amc-DKpi-compare">
                  <div class="amc-DKpi-side amc-DKpi-side--now">
                    <dt class="amc-DKpi-sideLabel">{if ?DESCRIPTION/}#DESCRIPTION#{else/}Current{endif/}</dt>
                    <dd class="amc-DKpi-value"><span class="amc-DKpi-num">#VALUE#</span>{if ?UNIT/}<span class="amc-DKpi-unit">#UNIT#</span>{endif/}</dd>
                  </div>
                  {if ?COMPARE_VALUE/}<div class="amc-DKpi-side amc-DKpi-side--was">
                    <dt class="amc-DKpi-sideLabel">{if ?COMPARE_LABEL/}#COMPARE_LABEL#{else/}Previous{endif/}</dt>
                    <dd class="amc-DKpi-value"><span class="amc-DKpi-num">#COMPARE_VALUE#</span>{if ?UNIT/}<span class="amc-DKpi-unit">#UNIT#</span>{endif/}</dd>
                  </div>{endif/}
                </dl>{otherwise/}<p class="amc-DKpi-value"><span class="amc-DKpi-num">#VALUE#</span>{if ?UNIT/}<span class="amc-DKpi-unit">#UNIT#</span>{endif/}</p>{endcase/}
                {case STYLE/}{when targetBar/}<div class="amc-DKpi-target">
                  <progress class="amc-DKpi-bar" max="100" value="#PERCENT#" aria-label="#LABEL!ATTR#">#PERCENT#%</progress>
                  <p class="amc-DKpi-targetMeta">{if ?PERCENT/}<span class="amc-DKpi-pct">#PERCENT#%</span>{endif/}{if ?COMPARE_VALUE/}<span class="amc-DKpi-goal">{if ?COMPARE_LABEL/}#COMPARE_LABEL#{else/}Target{endif/} <span class="amc-DKpi-goalValue">#COMPARE_VALUE#</span></span>{endif/}</p>
                </div>{when sparkBars/}<div class="amc-DKpi-spark" data-series="#SERIES#" aria-hidden="true"></div>{otherwise/}{endcase/}
                {if ?CHANGE/}<p class="amc-DKpi-delta"><span class="amc-DKpi-deltaIcon fa {case TREND/}{when up/}fa-arrow-up{when down/}fa-arrow-down{otherwise/}fa-minus{endcase/}" aria-hidden="true"></span><span class="amc-DKpi-sr">{case TREND/}{when up/}Increase{when down/}Decrease{otherwise/}No change{endcase/}</span><span class="amc-DKpi-deltaText">#CHANGE#</span></p>{endif/}
                {case STYLE/}{when compare/}{otherwise/}{if ?DESCRIPTION/}<p class="amc-DKpi-desc">#DESCRIPTION#</p>{endif/}{endcase/}
              </div>
            </div>
            ```
        reportBody:
            ```html
            <ul class="amc-DKpis amc-DKpis--#STYLE#">#APEX$ROWS#</ul>
            ```
        reportRow:
            ```html
            <li class="amc-DKpis-item">#APEX$PARTIAL#</li>
            ```
        translateTemplates: true
        defaultEscapeMode: html
    }
    advanced {
        filePrefix: #PLUGIN_FILES#
        quickPick: false
        substituteAttributeValues: true
        deprecated: false
        legacy: false
    }
    css {
        fileUrls: [
            #PLUGIN_FILES#amc-design-kpi.css
        ]
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#amc-design-kpi.js
        ]
    }
    information {
        version: 1.0.1
        helpText:
            ```
            Pick a Style, then map Label and Value (formatted in SQL with the application's NLS settings). Change and Trend (up, down or flat) add a trend indicator. Percent (a number from 0 to 100) drives the Target Bar and Ring styles, Series (comma-separated numbers) drives Spark Bars, and Compare Value / Compare Label drive the Compare and Target Bar styles. Colors follow the active Universal Theme style, including dark styles and Theme Roller changes.
            ```
    }
    customAttribute STYLE (
        apexlangName: style
        attribute: 1
        name: Style
        scope: component
        type: selectList
        appearance {
            sequence: 10
        }
        componentLov {
            type: static
        }
        validation {
            required: true
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: bigNumber
        }
        help {
            helpText:
                ```
                The tile design. Big Number: oversized figure with a footer. Delta Chip: change shown as a colored pill. Glass: translucent blurred surface. Gradient: filled with the primary color. Compare: current value next to a comparison value. Target Bar: progress toward a target, uses Percent. Ring: circular gauge, uses Percent. Spark Bars: mini bar chart, uses Series. Icon Left: solid icon tile beside the figure. Minimal: no card, typographic only.
                ```
        }
        entry bigNumber (
            sequence: 10
            display: Big Number
            return: bigNumber
        )
        entry deltaChip (
            sequence: 20
            display: Delta Chip
            return: deltaChip
        )
        entry glass (
            sequence: 30
            display: Glass
            return: glass
        )
        entry gradient (
            sequence: 40
            display: Gradient
            return: gradient
        )
        entry compare (
            sequence: 50
            display: Compare
            return: compare
        )
        entry targetBar (
            sequence: 60
            display: Target Bar
            return: targetBar
        )
        entry ring (
            sequence: 70
            display: Ring
            return: ring
        )
        entry sparkBars (
            sequence: 80
            display: Spark Bars
            return: sparkBars
        )
        entry iconLeft (
            sequence: 90
            display: Icon Left
            return: iconLeft
        )
        entry minimal (
            sequence: 100
            display: Minimal
            return: minimal
        )
    )
    customAttribute LABEL (
        apexlangName: label
        attribute: 2
        name: Label
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 20
        }
        validation {
            required: true
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Name of the metric, for example Monthly Revenue. Rendered as the tile heading.
                ```
        }
    )
    customAttribute VALUE (
        apexlangName: value
        attribute: 3
        name: Value
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 30
        }
        validation {
            required: true
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                The key figure as display text. Format it in SQL, for example to_char(amount, 'FML999G999G990'), so it follows the application's NLS settings.
                ```
        }
    )
    customAttribute UNIT (
        apexlangName: unit
        attribute: 4
        name: Unit
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 40
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional unit shown after the value, for example SAR, %, h or orders.
                ```
        }
    )
    customAttribute CHANGE (
        apexlangName: change
        attribute: 5
        name: Change
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 50
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional change text such as +12.4% or -9. Leave empty to hide the trend indicator.
                ```
        }
    )
    customAttribute TREND (
        apexlangName: trend
        attribute: 6
        name: Trend
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 60
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Direction of the change: up, down or flat. Any other value renders as flat. Up is shown in the success color and down in the danger color unless Down Is Good is set.
                ```
        }
    )
    customAttribute INVERT_TREND (
        apexlangName: invertTrend
        attribute: 7
        name: Down Is Good
        scope: component
        type: yesNo
        appearance {
            sequence: 70
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: false
        }
        help {
            helpText:
                ```
                Swap the trend colors so a decrease is shown as positive, for example for costs, churn or error rates.
                ```
        }
    )
    customAttribute PERCENT (
        apexlangName: percent
        attribute: 8
        name: Percent
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 80
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Target Bar and Ring styles: a number from 0 to 100 with a period as decimal separator, for example 72 or 64.5. Values outside the range are clamped; non-numeric values show an empty bar or ring.
                ```
        }
    )
    customAttribute SERIES (
        apexlangName: series
        attribute: 9
        name: Series
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 90
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Spark Bars style: comma-separated numbers, oldest first, with a period as decimal separator, for example 12,18,15,22,27. Up to 24 values are drawn; the last one is highlighted. Build it in SQL with listagg.
                ```
        }
    )
    customAttribute COMPARE_VALUE (
        apexlangName: compareValue
        attribute: 10
        name: Compare Value
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 100
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Compare style: the reference figure, for example last quarter's value. Target Bar style: the target, for example 1,500,000. Format it in SQL like Value.
                ```
        }
    )
    customAttribute COMPARE_LABEL (
        apexlangName: compareLabel
        attribute: 11
        name: Compare Label
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 110
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Caption for Compare Value, for example Last quarter or Target. Defaults to Previous in the Compare style and Target in the Target Bar style.
                ```
        }
    )
    customAttribute ICON (
        apexlangName: icon
        attribute: 12
        name: Icon
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 120
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Font APEX icon class, for example fa-line-chart. Shown by the Glass, Gradient and Icon Left styles.
                ```
        }
    )
    customAttribute DESCRIPTION (
        apexlangName: description
        attribute: 13
        name: Description
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 130
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional footnote, for example vs. last month. In the Compare style it captions the current value, for example This quarter.
                ```
        }
    )
    file "amc-design-kpi.css" (
        fileName: amc-design-kpi.css
        mimeType: text/css
        charSet: utf-8
    )
    file "amc-design-kpi.js" (
        fileName: amc-design-kpi.js
        mimeType: application/javascript
        charSet: utf-8
    )
)
