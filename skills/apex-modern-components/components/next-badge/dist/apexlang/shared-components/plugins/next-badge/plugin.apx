plugin nextBadge (
    name: Next Badge
    staticId: AMC_NEXT_BADGE
    type: templateComponent
    templateComponent {
        availableAs: [
            partial
            report
        ]
        partial:
            ```html
            <span class="amc-NBadge amc-NBadge--#STYLE# {case STATE/}{when success/}amc-NBadge--success{when warning/}amc-NBadge--warning{when danger/}amc-NBadge--danger{when info/}amc-NBadge--info{otherwise/}amc-NBadge--neutral{endcase/}"{case STYLE/}{when expandLabel/} tabindex="0"{endcase/}><span class="amc-NBadge-fx" aria-hidden="true"></span>{case STYLE/}{when pulseLive/}<span class="amc-NBadge-dot" aria-hidden="true"></span>{when expandLabel/}<span class="amc-NBadge-dot" aria-hidden="true">{if ?ICON/}<span class="fa #ICON#"></span>{endif/}</span>{when stackCount/}<span class="amc-NBadge-dot" aria-hidden="true">{if ?ICON/}<span class="fa #ICON#"></span>{endif/}</span>{otherwise/}{if ?ICON/}<span class="amc-NBadge-icon fa #ICON#" aria-hidden="true"></span>{endif/}{endcase/}<span class="amc-NBadge-text"><span class="amc-NBadge-label">#LABEL#</span></span>{case STYLE/}{when pulseLive/}<span class="amc-NBadge-bars" aria-hidden="true"><span class="amc-NBadge-bar"></span><span class="amc-NBadge-bar"></span><span class="amc-NBadge-bar"></span></span>{endcase/}{if ?VALUE/}<span class="amc-NBadge-value">#VALUE#</span>{endif/}</span>
            ```
        reportBody:
            ```html
            <ul class="amc-NBadges amc-NBadges--#STYLE#"{case STYLE/}{when stackCount/} tabindex="0"{endcase/}>#APEX$ROWS#</ul>
            ```
        reportRow:
            ```html
            <li class="amc-NBadges-item">#APEX$PARTIAL#</li>
            ```
        translateTemplates: false
        defaultEscapeMode: html
    }
    advanced {
        filePrefix: #PLUGIN_FILES#
        quickPick: false
        substituteAttributeValues: true
        deprecated: false
        legacy: false
    }
    css {
        fileUrls: [
            #PLUGIN_FILES#amc-next-badge.css
        ]
    }
    information {
        version: 1.0.0
        helpText:
            ```
            Choose a Style, map Label to the text and State to a column returning success, warning, danger, info or neutral (anything else renders as neutral). The label must carry the meaning, for example Paid or Overdue, so state is never shown by color alone. Value adds a second segment: the viewer or item count in Live pulse and Stack count, trailing text elsewhere. Expand label and Stack count are keyboard focusable, show their labels on hover or focus, and always show them on touch screens.
            ```
    }
    customAttribute STYLE (
        apexlangName: style
        attribute: 1
        name: Style
        scope: component
        type: selectList
        appearance {
            sequence: 10
        }
        componentLov {
            type: static
        }
        validation {
            required: true
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: shine
        }
        help {
            helpText:
                ```
                Badge design and its Next Collection direction. Motion: Shine, Live pulse, Beam outline. Depth: Sticker tilt, Extruded. Bold: Neo-brutal, Clay, Holo foil. Smart: Expand label shows an icon dot that grows into its label on hover or focus, and in report mode shows every label when the region is wider than about 40rem; Stack count overlaps the report rows as a stack of dots with a total count and fans them out into labeled pills on hover or focus.
                ```
        }
        entry shine (
            sequence: 10
            display: Shine
            return: shine
        )
        entry pulseLive (
            sequence: 20
            display: Live pulse
            return: pulseLive
        )
        entry beamOutline (
            sequence: 30
            display: Beam outline
            return: beamOutline
        )
        entry stickerTilt (
            sequence: 40
            display: Sticker tilt
            return: stickerTilt
        )
        entry extruded (
            sequence: 50
            display: Extruded
            return: extruded
        )
        entry neoBrutal (
            sequence: 60
            display: Neo-brutal
            return: neoBrutal
        )
        entry clay (
            sequence: 70
            display: Clay
            return: clay
        )
        entry holo (
            sequence: 80
            display: Holo foil
            return: holo
        )
        entry expandLabel (
            sequence: 90
            display: Expand label
            return: expandLabel
        )
        entry stackCount (
            sequence: 100
            display: Stack count
            return: stackCount
        )
    )
    customAttribute LABEL (
        apexlangName: label
        attribute: 2
        name: Label
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 20
        }
        validation {
            required: true
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Badge text, for example Paid, Overdue or In Review. Keep it short; it must convey the state in words. Expand label and Stack count hide it visually until hover or focus, but screen readers always read it.
                ```
        }
    )
    customAttribute STATE (
        apexlangName: state
        attribute: 3
        name: State
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 30
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Semantic color: success, warning, danger, info or neutral. Empty or any other value renders as neutral. Can be static text or a column.
                ```
        }
    )
    customAttribute ICON (
        apexlangName: icon
        attribute: 4
        name: Icon
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 40
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Optional Font APEX icon class, for example fa-check or fa-truck. Shown before the label; Expand label and Stack count show it inside the colored dot, and Live pulse draws its own pulsing dot instead.
                ```
        }
    )
    customAttribute VALUE (
        apexlangName: value
        attribute: 5
        name: Value
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 50
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Optional second segment after the label, for example 24 or 3 days. Live pulse shows it as a live counter, Stack count as the count bubble of a single badge. Format numbers in SQL.
                ```
        }
    )
    file "amc-next-badge.css" (
        fileName: amc-next-badge.css
        mimeType: text/css
        charSet: utf-8
    )
)
