plugin motionSpotlightCards (
    name: Motion Spotlight Cards
    staticId: AMC_MOTION_SPOTLIGHT_CARDS
    type: templateComponent
    templateComponent {
        availableAs: [
            report
        ]
        partial:
            ```html
            <div class="amc-SpotCard{if ?LINK_URL/} amc-SpotCard--link{endif/}">
              {if ?BADGE/}<span class="amc-SpotCard-badge">#BADGE#</span>{endif/}
              {if ?ICON/}<span class="amc-SpotCard-icon" aria-hidden="true"><span class="fa #ICON#"></span></span>{endif/}
              <h3 class="amc-SpotCard-title">{if ?LINK_URL/}<a class="amc-SpotCard-link" href="#LINK_URL#">#TITLE#</a>{else/}#TITLE#{endif/}</h3>
              {if ?TEXT/}<p class="amc-SpotCard-text">#TEXT#</p>{endif/}
            </div>
            ```
        reportBody:
            ```html
            <ul class="amc-SpotCards{if ?COLUMNS/} amc-SpotCards--cols#COLUMNS#{endif/}">#APEX$ROWS#</ul>
            ```
        reportRow:
            ```html
            <li class="amc-SpotCards-item">#APEX$PARTIAL#</li>
            ```
        translateTemplates: false
        defaultEscapeMode: html
    }
    advanced {
        filePrefix: #PLUGIN_FILES#
        quickPick: false
        substituteAttributeValues: true
        deprecated: false
        legacy: false
    }
    css {
        fileUrls: [
            #PLUGIN_FILES#amc-motion-spotlight-cards.css
        ]
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#amc-motion-spotlight-cards.js
        ]
    }
    information {
        version: 1.0.1
        helpText:
            ```
            Each query row is one card. The effect needs a mouse or trackpad; on touch screens the cards show as clean static cards. Colors follow the theme primary color.
            ```
    }
    customAttribute TITLE (
        apexlangName: title
        attribute: 1
        name: Title
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 10
        }
        validation {
            required: true
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Card heading.
                ```
        }
    )
    customAttribute TEXT (
        apexlangName: text
        attribute: 2
        name: Text
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 20
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Supporting text under the title.
                ```
        }
    )
    customAttribute ICON (
        apexlangName: icon
        attribute: 3
        name: Icon
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 30
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Font APEX icon class, for example fa-bar-chart.
                ```
        }
    )
    customAttribute BADGE (
        apexlangName: badge
        attribute: 4
        name: Badge
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 40
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Small label in the corner, for example New or a count.
                ```
        }
    )
    customAttribute LINK_URL (
        apexlangName: linkUrl
        attribute: 5
        name: Link URL
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 50
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Optional target for the whole card. Must be developer-controlled.
                ```
        }
    )
    customAttribute COLUMNS (
        apexlangName: columns
        attribute: 6
        name: Columns
        scope: component
        type: selectList
        appearance {
            sequence: 60
        }
        componentLov {
            type: static
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Leave empty to fit as many cards as the width allows. Fixed column counts collapse to one column on phones.
                ```
        }
        entry two (
            sequence: 10
            display: 2 Columns
            return: 2
        )
        entry three (
            sequence: 20
            display: 3 Columns
            return: 3
        )
        entry four (
            sequence: 30
            display: 4 Columns
            return: 4
        )
    )
    file "amc-motion-spotlight-cards.css" (
        fileName: amc-motion-spotlight-cards.css
        mimeType: text/css
        charSet: utf-8
    )
    file "amc-motion-spotlight-cards.js" (
        fileName: amc-motion-spotlight-cards.js
        mimeType: application/javascript
        charSet: utf-8
    )
)
