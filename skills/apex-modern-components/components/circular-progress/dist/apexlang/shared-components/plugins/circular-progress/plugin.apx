plugin circularProgress (
    name: Circular Progress
    staticId: AMC_CIRCULAR_PROGRESS
    type: templateComponent
    templateComponent {
        availableAs: [
            partial
            report
        ]
        partial:
            ```html
            <figure class="amc-Ring{if ?SIZE/} amc-Ring--#SIZE#{endif/} {case STATE/}{when success/}amc-Ring--success{when warning/}amc-Ring--warning{when danger/}amc-Ring--danger{when info/}amc-Ring--info{otherwise/}amc-Ring--primary{endcase/}">
              <div class="amc-Ring-gauge" role="progressbar" aria-valuemin="0" aria-valuemax="{if ?MAX/}#MAX#{else/}100{endif/}" aria-valuenow="#VALUE#"{if ?CENTER_TEXT/} aria-valuetext="#CENTER_TEXT!ATTR#"{endif/}{if ?LABEL/} aria-label="#LABEL!ATTR#"{endif/} data-value="#VALUE#" data-max="{if ?MAX/}#MAX#{else/}100{endif/}">
                <svg class="amc-Ring-svg" viewBox="0 0 100 100" aria-hidden="true" focusable="false">
                  <circle class="amc-Ring-track" cx="50" cy="50" r="42" pathLength="100"></circle>
                  <circle class="amc-Ring-bar" cx="50" cy="50" r="42" pathLength="100"></circle>
                </svg>
                <span class="amc-Ring-center" aria-hidden="true">{if ?CENTER_TEXT/}#CENTER_TEXT#{endif/}</span>
              </div>
              {if ?LABEL/}<figcaption class="amc-Ring-label">#LABEL#</figcaption>{endif/}
            </figure>
            ```
        reportBody:
            ```html
            <ul class="amc-Rings">#APEX$ROWS#</ul>
            ```
        reportRow:
            ```html
            <li class="amc-Rings-item">#APEX$PARTIAL#</li>
            ```
        translateTemplates: false
        defaultEscapeMode: html
    }
    advanced {
        filePrefix: #PLUGIN_FILES#
        quickPick: false
        substituteAttributeValues: true
        deprecated: false
        legacy: false
    }
    css {
        fileUrls: [
            #PLUGIN_FILES#amc-circular-progress.css
        ]
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#amc-circular-progress.js
        ]
    }
    information {
        version: 1.0.1
        helpText:
            ```
            Map Value (and optionally Maximum) to numeric columns. The ring animates from zero on load and after region refresh; users with reduced motion see it without animation. Non-numeric values show an empty ring.
            ```
    }
    customAttribute VALUE (
        apexlangName: value
        attribute: 1
        name: Value
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 10
        }
        validation {
            required: true
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Current numeric value, with a period as decimal separator.
                ```
        }
    )
    customAttribute MAX (
        apexlangName: max
        attribute: 2
        name: Maximum
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 20
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: 100
        }
        help {
            helpText:
                ```
                Value of a full ring. Defaults to 100.
                ```
        }
    )
    customAttribute CENTER_TEXT (
        apexlangName: centerText
        attribute: 3
        name: Center Text
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 30
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Text in the middle of the ring, for example 72% or 8/12. Leave empty to show the percentage computed from Value and Maximum.
                ```
        }
    )
    customAttribute LABEL (
        apexlangName: label
        attribute: 4
        name: Label
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 40
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Caption under the ring. Also the accessible name.
                ```
        }
    )
    customAttribute STATE (
        apexlangName: state
        attribute: 5
        name: State
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 50
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Optional success, warning, danger or info. Anything else uses the primary color.
                ```
        }
    )
    customAttribute SIZE (
        apexlangName: size
        attribute: 6
        name: Size
        scope: component
        type: selectList
        appearance {
            sequence: 60
        }
        componentLov {
            type: static
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Ring diameter.
                ```
        }
        entry small (
            sequence: 10
            display: Small, 64px
            return: sm
        )
        entry large (
            sequence: 20
            display: Large, 160px
            return: lg
        )
    )
    file "amc-circular-progress.css" (
        fileName: amc-circular-progress.css
        mimeType: text/css
        charSet: utf-8
    )
    file "amc-circular-progress.js" (
        fileName: amc-circular-progress.js
        mimeType: application/javascript
        charSet: utf-8
    )
)
