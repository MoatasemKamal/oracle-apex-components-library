plugin motionInteraction (
    name: Motion Interaction
    staticId: AMC_MOTION_INTERACTION
    type: templateComponent
    templateComponent {
        availableAs: [
            partial
        ]
        partial:
            ```html
            <div class="amc-Motion amc-Motion--ix" data-amc-ix="#EFFECT#">{case EFFECT/}
              {when ripple/}{if ?LINK_URL/}<a class="t-Button t-Button--hot amc-ix-ripple" href="#LINK_URL#"><span class="t-Button-label">#LABEL#</span></a>{else/}<button class="t-Button t-Button--hot amc-ix-ripple" type="button"><span class="t-Button-label">#LABEL#</span></button>{endif/}
              {when magnetic/}{if ?LINK_URL/}<a class="t-Button t-Button--hot amc-ix-mag" href="#LINK_URL#"><span class="t-Button-label">#LABEL#</span></a>{else/}<button class="t-Button t-Button--hot amc-ix-mag" type="button"><span class="t-Button-label">#LABEL#</span></button>{endif/}
              {when squish/}{if ?LINK_URL/}<a class="t-Button t-Button--hot amc-ix-squish" href="#LINK_URL#"><span class="t-Button-label">#LABEL#</span></a>{else/}<button class="t-Button t-Button--hot amc-ix-squish" type="button"><span class="t-Button-label">#LABEL#</span></button>{endif/}
              {when tilt/}<div class="amc-ix-tiltwrap">{if ?LINK_URL/}<a class="amc-ix-tilt" href="#LINK_URL#">{else/}<div class="amc-ix-tilt">{endif/}<span class="amc-glare" aria-hidden="true"></span><span class="amc-ix-tilt-body"><strong class="amc-ix-title">#LABEL#</strong>{if ?TEXT/}<span class="amc-ix-text">#TEXT#</span>{endif/}</span>{if ?LINK_URL/}</a>{else/}</div>{endif/}</div>
              {when spotlight/}<div class="amc-ix-spot">{if ?LINK_URL/}<a class="amc-ix-spot-link" href="#LINK_URL#">{else/}<span class="amc-ix-spot-link">{endif/}<strong class="amc-ix-title">#LABEL#</strong>{if ?TEXT/}<span class="amc-ix-text">#TEXT#</span>{endif/}{if ?LINK_URL/}</a>{else/}</span>{endif/}</div>
              {when like/}<button class="amc-ix-heart{if LIKED/} amc-on{endif/}" type="button" aria-pressed="{if LIKED/}true{else/}false{endif/}" aria-label="#LABEL!ATTR#"{if ?TEXT/} data-amc-value="#TEXT!ATTR#"{endif/}>
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 4.5 6.8 4.5c2.1 0 3.6 1.2 4.4 2.5.8-1.3 2.3-2.5 4.4-2.5 3.8 0 5.9 3.9 4.4 7.3C19.5 16.4 12 21 12 21z"/></svg>
                <i class="amc-dot" style="--a:0deg"></i><i class="amc-dot" style="--a:45deg"></i><i class="amc-dot" style="--a:90deg"></i><i class="amc-dot" style="--a:135deg"></i>
                <i class="amc-dot" style="--a:180deg"></i><i class="amc-dot" style="--a:225deg"></i><i class="amc-dot" style="--a:270deg"></i><i class="amc-dot" style="--a:315deg"></i>
              </button>
            {endcase/}</div>
            ```
        translateTemplates: false
        defaultEscapeMode: html
    }
    advanced {
        filePrefix: #PLUGIN_FILES#
        quickPick: false
        substituteAttributeValues: true
        deprecated: false
        legacy: false
    }
    css {
        fileUrls: [
            #PLUGIN_FILES#amc-motion-interaction.css
        ]
    }
    javaScript {
        fileUrls: [
            #PLUGIN_FILES#amc-motion-interaction.js
        ]
    }
    information {
        version: 1.0.0
        helpText:
            ```
            Buttons and cards navigate to Link URL when it is set. The like toggle fires the custom event amc-like-change with detail.liked and detail.value; catch it with a Dynamic Action to save the choice.
            ```
    }
    customAttribute EFFECT (
        apexlangName: effect
        attribute: 1
        name: Effect
        scope: component
        type: selectList
        appearance {
            sequence: 10
        }
        componentLov {
            type: static
        }
        validation {
            required: true
        }
        security {
            escapeMode: htmlAttribute
        }
        default {
            value: ripple
        }
        help {
            helpText:
                ```
                The interaction.
                ```
        }
        entry ripple (
            sequence: 10
            display: Ripple button
            return: ripple
        )
        entry magnetic (
            sequence: 20
            display: Magnetic button
            return: magnetic
        )
        entry squish (
            sequence: 30
            display: Squish button
            return: squish
        )
        entry tilt (
            sequence: 40
            display: Tilt card
            return: tilt
        )
        entry spotlight (
            sequence: 50
            display: Spotlight panel
            return: spotlight
        )
        entry like (
            sequence: 60
            display: Like toggle
            return: like
        )
    )
    customAttribute LABEL (
        apexlangName: label
        attribute: 2
        name: Label
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 20
        }
        validation {
            required: true
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Button label, card or panel title, or the accessible name of the like toggle.
                ```
        }
    )
    customAttribute TEXT (
        apexlangName: text
        attribute: 3
        name: Text
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 30
        }
        validation {
            required: false
        }
        security {
            escapeMode: html
        }
        help {
            helpText:
                ```
                Tilt card and spotlight: supporting text. Like toggle: a value passed in the amc-like-change event, for example the record ID.
                ```
        }
    )
    customAttribute LINK_URL (
        apexlangName: linkUrl
        attribute: 4
        name: Link URL
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 40
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        help {
            helpText:
                ```
                Optional target for buttons, tilt card and spotlight, for example from apex_page.get_url. Must be developer-controlled.
                ```
        }
    )
    customAttribute LIKED (
        apexlangName: liked
        attribute: 5
        name: Liked
        scope: component
        type: sessionStateValue
        appearance {
            sequence: 50
        }
        validation {
            required: false
        }
        security {
            escapeMode: htmlAttribute
        }
        dependingOn {
            attribute: @EFFECT
            conditionType: =
            value: like
            alwaysEvaluate: false
        }
        help {
            helpText:
                ```
                Like toggle only: Y to show it as liked, for example from a column.
                ```
        }
    )
    file "amc-motion-interaction.css" (
        fileName: amc-motion-interaction.css
        mimeType: text/css
        charSet: utf-8
    )
    file "amc-motion-interaction.js" (
        fileName: amc-motion-interaction.js
        mimeType: application/javascript
        charSet: utf-8
    )
)
