regionTemplate amc-insight-frame (
    name: AMC Insight Frame
    region {
        template:
            ```html
            <section class="amc-TInsightFrame #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading" data-amc-label-rows="Rows" data-amc-label-total="Total" data-amc-label-average="Average" data-amc-label-largest="Largest" data-amc-label-smallest="Smallest" data-amc-label-share="of total" data-amc-label-of="by">
              <div class="amc-TInsightFrame-surface">
                <header class="amc-TInsightFrame-header">
                  <span class="amc-TInsightFrame-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                  <h2 class="amc-TInsightFrame-title" id="#REGION_STATIC_ID#_heading">#TITLE#</h2>
                  <div class="amc-TInsightFrame-actions">#HELP##EDIT##CHANGE##COPY##DELETE##CREATE#</div>
                </header>
                <div class="amc-TInsightFrame-insight" hidden></div>
                <div class="amc-TInsightFrame-stage">
                  <div class="amc-TInsightFrame-body">#BODY##SUB_REGIONS#</div>
                  <div class="amc-TInsightFrame-layer" aria-hidden="true"></div>
                </div>
                <footer class="amc-TInsightFrame-footer">#PREVIOUS##CLOSE##NEXT#</footer>
                <p class="amc-TInsightFrame-live" role="status" aria-live="polite"></p>
              </div>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    javaScript {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-insight-frame.js
        ]
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-insight-frame.css
        ]
    }
    advanced {
        staticId: AMC_TPL_INSIGHT_FRAME
        translatable: false
    }
    comments {
        comments:
            ```text
            Content-aware region template. The script reads the first data table in the region body with textContent, never changing it, and parses numbers locale-safely: group separators, currency prefixes or suffixes such as SAR or a currency symbol, a comma or dot decimal mark by position, negatives as -1,200 or (1,200), percentages, and Arabic-Indic digits. Codes such as SO-55120, dates and year or ID columns are not treated as measures. The key column is the last numeric column; the Use first numeric column option picks the first, and a region Custom Attribute data-amc-column="Amount" (header text or 1-based position) picks one by name. Row labels come from the first descriptive text column, or data-amc-label-column. The strip shows the total as headline with Rows, Average and Largest, formatted with the same separators and currency as the report; percentage columns and the Average headline option make the average the headline. Hovering or focusing the Largest or Smallest value draws a ring around that row and clicking it scrolls the row into view; hovering a row lights its segment in the distribution bar and shows its share. Share bars are hidden when the column has negative values. It recomputes after apexafterrefresh and when the body changes, glows once and announces a summary politely through a status region. Without a table the region is a plain frame. English strings to translate, on the section element in the template or per region as Custom Attributes: data-amc-label-rows Rows, data-amc-label-total Total, data-amc-label-average Average, data-amc-label-largest Largest, data-amc-label-smallest Smallest, data-amc-label-share of total. Under reduced motion there is no glow or fade; in forced-colors mode bars use Highlight. JavaScript API: amcTplInsightFrame.refresh(element) and result(element).
            ```
    }

    templateOption amc-insight-frame-first-numeric (
        name: Use first numeric column
        sequence: 10
        appearance {
            cssClasses: amc-TInsightFrame--first
        }
        help {
            helpText:
                ```text
                Summarise the first numeric column instead of the last one, for reports where the measure comes before derived columns.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: FIRST_NUMERIC
        }
    )

    templateOption amc-insight-frame-min-max (
        name: Show smallest
        sequence: 20
        appearance {
            cssClasses: amc-TInsightFrame--minMax
        }
        help {
            helpText:
                ```text
                Adds the smallest value with its row label next to the largest, so the strip shows the full range.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: MIN_MAX
        }
    )

    templateOption amc-insight-frame-average-headline (
        name: Average as headline
        sequence: 30
        appearance {
            cssClasses: amc-TInsightFrame--avgHeadline
        }
        help {
            helpText:
                ```text
                The large figure is the average instead of the total, for rates, scores and durations where a sum means nothing. Percentage columns do this automatically.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: AVERAGE_HEADLINE
        }
    )

    templateOption amc-insight-frame-no-row-bars (
        name: Hide row bars
        sequence: 40
        appearance {
            cssClasses: amc-TInsightFrame--noBars
        }
        help {
            helpText:
                ```text
                Keeps the insight strip but draws no share bar under each row, for dense reports or reports with their own inline charts.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_ROW_BARS
        }
    )

    templateOption amc-insight-frame-no-body-padding (
        name: No body padding
        sequence: 50
        appearance {
            cssClasses: amc-TInsightFrame--noPadding
        }
        help {
            helpText:
                ```text
                Removes side padding so reports run edge to edge.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_BODY_PADDING
        }
    )
)
