listTemplate amc-dock-bar (
    name: AMC Dock Bar
    list {
        beforeEntries:
            ```html
            <div class="amc-TDockBar #COMPONENT_CSS_CLASSES#" id="#LIST_ID#">
            <ul class="amc-TDockBar-shelf">
            ```
        afterEntries:
            ```html
            </ul>
            </div>
            ```
    }
    entry {
        current:
            ```html
            <li class="amc-TDockBar-item is-current"><a class="amc-TDockBar-link" href="#LINK#" aria-current="page"><span class="amc-TDockBar-tip"><span class="amc-TDockBar-label">#TEXT#</span></span><span class="amc-TDockBar-tile"><span class="amc-TDockBar-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span><span class="amc-TDockBar-badge">#A01#</span></span></a></li>
            ```
        noncurrent:
            ```html
            <li class="amc-TDockBar-item"><a class="amc-TDockBar-link" href="#LINK#"><span class="amc-TDockBar-tip"><span class="amc-TDockBar-label">#TEXT#</span></span><span class="amc-TDockBar-tile"><span class="amc-TDockBar-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span><span class="amc-TDockBar-badge">#A01#</span></span></a></li>
            ```
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-dock-bar.css
        ]
    }
    attributeDescriptions {
        a01: Badge count
    }
    advanced {
        staticId: AMC_TPL_DOCK_BAR
        translatable: false
    }
    comments {
        comments:
            ```text
            List template for a List region. Each entry is an icon tile; the entry text is the tooltip label and User Defined Attribute 1 is an optional badge count shown in the danger color, for example 12. The tile under the pointer or with keyboard focus grows, and its two neighbours on each side grow less (pure CSS, no JavaScript). The current entry gets a glowing dot on the shelf. Neighbouring tiles rotate the theme's primary hue in browsers with relative color syntax. On touch screens labels are always visible; in containers narrower than 420px the dock wraps into a glass tray with labels under the tiles. Reduced motion turns magnification into a focus ring. Template options: Large tiles, Always show labels, Soft tiles, Flat glass dock, Float at page bottom.
            ```
    }

    templateOption amc-dock-bar-large (
        name: Large tiles
        sequence: 10
        appearance {
            cssClasses: amc-TDockBar--large
        }
        help {
            helpText:
                ```text
                64px tiles instead of 52px, for home pages with few entries.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: LARGE
        }
    )

    templateOption amc-dock-bar-labels (
        name: Always show labels
        sequence: 20
        appearance {
            cssClasses: amc-TDockBar--labels
        }
        help {
            helpText:
                ```text
                Shows every label above its tile, not only on hover and focus.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: LABELS
        }
    )

    templateOption amc-dock-bar-soft (
        name: Soft tiles
        sequence: 30
        appearance {
            cssClasses: amc-TDockBar--soft
        }
        help {
            helpText:
                ```text
                Light tiles with a primary-colored icon instead of glossy colored tiles, for calmer pages.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: SOFT
        }
    )

    templateOption amc-dock-bar-flat (
        name: Flat glass dock
        sequence: 40
        appearance {
            cssClasses: amc-TDockBar--flat
        }
        help {
            helpText:
                ```text
                Replaces the 3D shelf and reflections with a frosted glass bar around the tiles.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: FLAT
        }
    )

    templateOption amc-dock-bar-fixed (
        name: Float at page bottom
        sequence: 50
        appearance {
            cssClasses: amc-TDockBar--fixed
        }
        help {
            helpText:
                ```text
                Pins the dock to the bottom center of the browser window above the page content. Use it once per page, for example on page 0.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: FIXED
        }
    )
)
