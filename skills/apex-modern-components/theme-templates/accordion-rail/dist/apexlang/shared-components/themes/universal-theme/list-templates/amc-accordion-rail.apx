listTemplate amc-accordion-rail (
    name: AMC Accordion Rail
    list {
        beforeEntries:
            ```html
            <div class="amc-TAccordionRail #COMPONENT_CSS_CLASSES#" id="#LIST_ID#">
            <ul class="amc-TAccordionRail-list">
            ```
        afterEntries:
            ```html
            </ul>
            </div>
            ```
    }
    entry {
        current:
            ```html
            <li class="amc-TAccordionRail-item is-current"><a class="amc-TAccordionRail-link" href="#LINK#" aria-current="page"><span class="amc-TAccordionRail-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span><span class="amc-TAccordionRail-label">#TEXT#</span><span class="amc-TAccordionRail-badge">#A01#</span></a></li>
            ```
        currentWithSublist:
            ```html
            <li class="amc-TAccordionRail-item amc-TAccordionRail-item--group is-current"><a class="amc-TAccordionRail-link" href="#LINK#"><span class="amc-TAccordionRail-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span><span class="amc-TAccordionRail-label">#TEXT#</span><span class="amc-TAccordionRail-badge">#A01#</span></a><details class="amc-TAccordionRail-group" open><summary class="amc-TAccordionRail-toggle"><span class="amc-TAccordionRail-srOnly">#TEXT#</span></summary>
            ```
        noncurrent:
            ```html
            <li class="amc-TAccordionRail-item"><a class="amc-TAccordionRail-link" href="#LINK#"><span class="amc-TAccordionRail-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span><span class="amc-TAccordionRail-label">#TEXT#</span><span class="amc-TAccordionRail-badge">#A01#</span></a></li>
            ```
        noncurrentWithSublist:
            ```html
            <li class="amc-TAccordionRail-item amc-TAccordionRail-item--group"><a class="amc-TAccordionRail-link" href="#LINK#"><span class="amc-TAccordionRail-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span><span class="amc-TAccordionRail-label">#TEXT#</span><span class="amc-TAccordionRail-badge">#A01#</span></a><details class="amc-TAccordionRail-group"><summary class="amc-TAccordionRail-toggle"><span class="amc-TAccordionRail-srOnly">#TEXT#</span></summary>
            ```
    }
    sublist {
        beforeEntries:
            ```html
            <ul class="amc-TAccordionRail-sub">
            ```
        afterEntries:
            ```html
            </ul></details></li>
            ```
    }
    sublistEntry {
        current:
            ```html
            <li class="amc-TAccordionRail-subitem is-current"><a class="amc-TAccordionRail-sublink" href="#LINK#" aria-current="page"><span class="amc-TAccordionRail-label">#TEXT#</span><span class="amc-TAccordionRail-badge">#A01#</span></a></li>
            ```
        noncurrent:
            ```html
            <li class="amc-TAccordionRail-subitem"><a class="amc-TAccordionRail-sublink" href="#LINK#"><span class="amc-TAccordionRail-label">#TEXT#</span><span class="amc-TAccordionRail-badge">#A01#</span></a></li>
            ```
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-accordion-rail.css
        ]
    }
    attributeDescriptions {
        a01: Badge
    }
    advanced {
        staticId: AMC_TPL_ACCORDION_RAIL
        translatable: false
    }
    comments {
        comments:
            ```text
            List template for side navigation with one level of sub lists. Every entry is a real link; the current entry gets aria-current=page, and a parent whose group holds the current page is shown on the current path. Entries with children render their link plus a native disclosure toggle, so groups open and close with the mouse, Enter or Space and without JavaScript; the current group starts open. In browsers that support ::details-content the group grows and shrinks smoothly. The rail lights up from the current parent down to the current page. Attribute 1 is a badge, hidden when empty. Template options: Icon rail clips the list to its icons and reveals it over the page on hover or keyboard focus, with a dot on icons that carry a badge; Compact tightens the rows; Panel puts the navigation on a card surface; Flowing light sends a light pulse along the lit rail. Under prefers-reduced-motion nothing animates; in forced-colors mode the rail and current entry use system colors.
            ```
    }

    templateOption amc-accordion-rail-icon-rail (
        name: Icon rail
        sequence: 10
        appearance {
            cssClasses: amc-TAccordionRail--iconRail
        }
        help {
            helpText:
                ```text
                Collapses the navigation to a narrow rail of icons. Hover or keyboard focus reveals the full list over the page; entries with a badge show a dot. Give every top-level entry an icon.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: ICON_RAIL
        }
    )

    templateOption amc-accordion-rail-compact (
        name: Compact
        sequence: 20
        appearance {
            cssClasses: amc-TAccordionRail--compact
        }
        help {
            helpText:
                ```text
                Shorter rows and smaller text for long navigation lists.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: COMPACT
        }
    )

    templateOption amc-accordion-rail-panel (
        name: Panel
        sequence: 30
        appearance {
            cssClasses: amc-TAccordionRail--panel
        }
        help {
            helpText:
                ```text
                Places the navigation on a card surface with a soft shadow, for use on the page background.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: PANEL
        }
    )

    templateOption amc-accordion-rail-flowing-light (
        name: Flowing light
        sequence: 40
        appearance {
            cssClasses: amc-TAccordionRail--pulse
        }
        help {
            helpText:
                ```text
                A light pulse flows down the lit part of the rail and the current node pings. Stops under reduced motion.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: FLOWING_LIGHT
        }
    )
)
