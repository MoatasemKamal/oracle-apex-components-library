      "body": "<table class=\"pv-report\"><thead><tr><th>Shipment</th><th>Consignee</th><th>Route</th><th>Status</th><th class=\"pv-num\">Weight kg</th></tr></thead><tbody><tr><td>SHP-30211</td><td>Al Noor Trading</td><td>Jeddah to Riyadh</td><td>In transit</td><td class=\"pv-num\">1,240</td></tr><tr><td>SHP-30214</td><td>Gulf Medical Supplies</td><td>Dammam to Khobar</td><td>Delivered</td><td class=\"pv-num\">380</td></tr><tr><td>SHP-30219</td><td>Red Sea Logistics</td><td>Jeddah port to Yanbu</td><td>At customs</td><td class=\"pv-num\">12,600</td></tr><tr><td>SHP-30222</td><td>Najd Foods</td><td>Riyadh to Qassim</td><td>Loading</td><td class=\"pv-num\">5,410</td></tr><tr><td>SHP-30227</td><td>Emirates Steel Trading</td><td>Dubai to Dammam</td><td>In transit</td><td class=\"pv-num\">22,000</td></tr></tbody></table>",
      "buttons": {
        "CREATE": "New shipment"
      }
    },
    {
      "title": "Around cards, accent bones",
      "regionTitle": "Sales overview",
      "icon": "fa-line-chart",
      "options": [
        "amc-TSkeletonRegion--accent"
      ],
      "body": "<style>.pv-kpis{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(170px,100%),1fr));gap:12px}.pv-kpi{display:grid;gap:4px;padding:12px 14px;border-radius:8px;border:1px solid var(--ut-component-border-color);background:var(--ut-component-background-color)}.pv-kpi span{font-size:12px;color:var(--ut-component-text-muted-color)}.pv-kpi strong{font-size:20px}.pv-kpi small{font-size:12px;color:var(--ut-component-text-muted-color)}</style><div class=\"pv-kpis\"><div class=\"pv-kpi\"><span>Open orders</span><strong>128</strong><small>12 due today</small></div><div class=\"pv-kpi\"><span>Revenue, September</span><strong>SAR 4.2M</strong><small>+6% on August</small></div><div class=\"pv-kpi\"><span>Overdue invoices</span><strong>14</strong><small>SAR 312,400</small></div><div class=\"pv-kpi\"><span>Avg. delivery</span><strong>2.6 days</strong><small>Riyadh to Dammam</small></div></div>"
    },
    {
      "title": "Around a form, pulse",
      "regionTitle": "Customer",
      "icon": "fa-user",
      "options": [
        "amc-TSkeletonRegion--pulse"
      ],
      "body": "<style>/* preview only: stand-in for Universal Theme items and grid */\n.container{width:100%}.row{display:flex;flex-wrap:wrap;margin-inline:-8px}.col{box-sizing:border-box;padding-inline:8px;flex:1 1 100%;min-width:0}.col-6{flex:0 0 50%;max-width:50%}.col-4{flex:0 0 33.333%;max-width:33.333%}\n@media (max-width:700px){.col-6,.col-4{flex-basis:100%;max-width:100%}}\n.t-Form-fieldContainer{margin:0 0 14px}.t-Form-labelContainer{margin:0 0 5px}.t-Form-label{display:inline-block;font-size:12px;font-weight:600;color:var(--ut-component-text-muted-color)}\n.t-Form-fieldContainer.is-required .t-Form-label::after{content:\" *\";color:var(--ut-palette-danger)}\n.u-VisuallyHidden{position:absolute!important;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}\n.t-Form-itemWrapper{display:flex}.apex-item-text,.apex-item-select,.apex-item-textarea{flex:1;min-width:0;box-sizing:border-box;font:inherit;font-size:14px;padding:8px 10px;border-radius:4px;border:1px solid var(--ut-component-border-color);background:var(--ut-component-background-color);color:var(--ut-component-text-default-color)}\n.apex-item-textarea{min-height:64px;resize:vertical}.apex-item-text:focus,.apex-item-select:focus,.apex-item-textarea:focus{outline:2px solid var(--ut-palette-primary);outline-offset:-1px}\n.t-Form-inlineHelp{margin-top:4px;font-size:12px;color:var(--ut-component-text-muted-color)}\n.t-Form-fieldContainer.is-error .apex-item-text,.t-Form-fieldContainer.is-error .apex-item-select{border-color:var(--ut-palette-danger)}\n.a-Form-error{display:none}.a-Form-error.u-visible{display:block}.t-Form-error{margin-top:4px;font-size:12px;color:var(--ut-palette-danger)}\n.apex-item-radio{display:flex;flex-wrap:wrap;gap:6px 18px;padding:6px 0;font-size:14px}.apex-item-option{display:flex;align-items:center;gap:6px}\n.apex-item-single-checkbox{display:flex;align-items:flex-start;gap:8px;font-size:14px;padding:4px 0}\n.pv-buttons{display:flex;flex-wrap:wrap;gap:8px;justify-content:flex-end;margin-top:4px}</style><div class=\"container\"><div class=\"row\"><div class=\"col col-6 apex-col-auto\"><div class=\"t-Form-fieldContainer apex-item-wrapper apex-item-wrapper--text-field\" id=\"P60_NAME_CONTAINER\"><div class=\"t-Form-labelContainer\"><label for=\"P60_NAME\" id=\"P60_NAME_LABEL\" class=\"t-Form-label\">Customer</label></div><div class=\"t-Form-inputContainer\"><div class=\"t-Form-itemWrapper\"><input type=\"text\" id=\"P60_NAME\" name=\"P60_NAME\" class=\"text_field apex-item-text\" value=\"Al Noor Trading Co.\" size=\"30\"></div><span id=\"P60_NAME_error_placeholder\" class=\"a-Form-error\"></span></div></div></div><div class=\"col col-6 apex-col-auto\"><div class=\"t-Form-fieldContainer apex-item-wrapper apex-item-wrapper--text-field\" id=\"P60_LIMIT_CONTAINER\"><div class=\"t-Form-labelContainer\"><label for=\"P60_LIMIT\" id=\"P60_LIMIT_LABEL\" class=\"t-Form-label\">Credit limit</label></div><div class=\"t-Form-inputContainer\"><div class=\"t-Form-itemWrapper\"><input type=\"text\" id=\"P60_LIMIT\" name=\"P60_LIMIT\" class=\"text_field apex-item-text\" value=\"SAR 250,000\" size=\"30\"></div><span id=\"P60_LIMIT_error_placeholder\" class=\"a-Form-error\"></span></div></div></div></div><div class=\"row\"><div class=\"col col-12 apex-col-auto\"><div class=\"t-Form-fieldContainer apex-item-wrapper apex-item-wrapper--textarea\" id=\"P60_NOTES_CONTAINER\"><div class=\"t-Form-labelContainer\"><label for=\"P60_NOTES\" id=\"P60_NOTES_LABEL\" class=\"t-Form-label\">Notes</label></div><div class=\"t-Form-inputContainer\"><div class=\"t-Form-itemWrapper\"><textarea id=\"P60_NOTES\" name=\"P60_NOTES\" rows=\"3\" class=\"textarea apex-item-textarea\">Net-30 terms. Key account for wholesale electronics in the Eastern Province.</textarea></div><span id=\"P60_NOTES_error_placeholder\" class=\"a-Form-error\"></span></div></div></div></div></div>"
    },
