regionTemplate amc-skeleton-region (
    name: AMC Skeleton Region
    region {
        template:
            ```html
            <section class="amc-TSkeletonRegion #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading" data-amc-delay="400" data-amc-min-show="350" data-amc-label-still="Still loading, %0 s" data-amc-label-slow="%0 is still loading" data-amc-label-done="%0 updated">
              <div class="amc-TSkeletonRegion-surface">
                <header class="amc-TSkeletonRegion-header">
                  <span class="amc-TSkeletonRegion-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                  <h2 class="amc-TSkeletonRegion-title" id="#REGION_STATIC_ID#_heading">#TITLE#</h2>
                  <span class="amc-TSkeletonRegion-elapsed" aria-hidden="true" hidden></span>
                  <div class="amc-TSkeletonRegion-actions">#HELP##EDIT##CHANGE##COPY##DELETE##CREATE#</div>
                </header>
                <div class="amc-TSkeletonRegion-stage">
                  <div class="amc-TSkeletonRegion-body">#BODY##SUB_REGIONS#</div>
                  <div class="amc-TSkeletonRegion-skeleton" aria-hidden="true" hidden></div>
                </div>
                <footer class="amc-TSkeletonRegion-footer">#PREVIOUS##CLOSE##NEXT#</footer>
                <p class="amc-TSkeletonRegion-live" role="status" aria-live="polite"></p>
              </div>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    javaScript {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-skeleton-region.js
        ]
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-skeleton-region.css
        ]
    }
    advanced {
        staticId: AMC_TPL_SKELETON_REGION
        translatable: false
    }
    comments {
        comments:
            ```text
            Motion region template for regions that refresh. Design principles: Doherty threshold: responses under about 400 ms feel immediate and must not show a loading state, because the flash itself disrupts; loading states: a skeleton that matches the real layout keeps spatial context and feels faster than a spinner, and shimmer respects reduced motion. How it works: on apexbeforerefresh of this region the script measures what is in the body right now, relative to the frame: every line of text, every form field and button, cards and other painted boxes, images, charts and canvases, and a rule under every report row. If apexafterrefresh arrives within data-amc-delay (400 ms) nothing is shown. Otherwise the skeleton is drawn over the body with one slow light sweep, the frame keeps its height so the page does not jump, the stage is aria-busy, and once shown it stays at least data-amc-min-show (350 ms) so it never flickers; then it fades out and a polite status says the region was updated. A 60 second failsafe removes it if no apexafterrefresh arrives. The body itself is never clipped, hidden or transformed. With the First load option an empty body at page load (lazy-loading regions) shows a synthetic shape until content arrives: set data-amc-skeleton="report|cards|form|text" and data-amc-skeleton-rows="5" as region Custom Attributes or on an element in the body. JavaScript API for your own Ajax: amcTplSkeletonRegion.start(element) and stop(element); shape(element) and state(element) for tests. English strings to translate, on the section element in the template or per region as Custom Attributes: data-amc-label-still Still loading, %0 s, data-amc-label-slow %0 is still loading, data-amc-label-done %0 updated (%0 = region title). Timing: data-amc-delay and data-amc-min-show in milliseconds. Reduced motion: a static skeleton with no sweep, pulse or fade. Forced colors: bones use GrayText.
            ```
    }

    templateOption amc-skeleton-region-first-load (
        name: Skeleton on first load
        sequence: 10
        appearance {
            cssClasses: amc-TSkeletonRegion--firstLoad
        }
        help {
            helpText:
                ```text
                When the body is empty at page load, for lazy-loading regions, a synthetic skeleton is shown after the threshold until content arrives. Shape from data-amc-skeleton.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: FIRST_LOAD
        }
    )

    templateOption amc-skeleton-region-pulse (
        name: Pulse instead of sweep
        sequence: 20
        appearance {
            cssClasses: amc-TSkeletonRegion--pulse
        }
        help {
            helpText:
                ```text
                The bones breathe in place instead of a light sweeping across, calmer for dashboards with many regions.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: PULSE
        }
    )

    templateOption amc-skeleton-region-accent (
        name: Accent bones
        sequence: 30
        appearance {
            cssClasses: amc-TSkeletonRegion--accent
        }
        help {
            helpText:
                ```text
                Tints the skeleton with the primary color instead of neutral grey.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: ACCENT
        }
    )

    templateOption amc-skeleton-region-elapsed (
        name: Show elapsed time
        sequence: 40
        appearance {
            cssClasses: amc-TSkeletonRegion--elapsed
        }
        help {
            helpText:
                ```text
                After 3 seconds the header shows Still loading with the seconds counting, and screen readers hear once that the region is still loading.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: ELAPSED
        }
    )

    templateOption amc-skeleton-region-no-body-padding (
        name: No body padding
        sequence: 50
        appearance {
            cssClasses: amc-TSkeletonRegion--noPadding
        }
        help {
            helpText:
                ```text
                Removes side padding so reports and cards run edge to edge.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_BODY_PADDING
        }
    )
)
