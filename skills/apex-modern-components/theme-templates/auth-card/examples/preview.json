      "body": "<div class=\"t-Form-fieldContainer apex-item-wrapper\"><div class=\"t-Form-labelContainer\"><label class=\"t-Form-label\">New password</label></div><div class=\"t-Form-inputContainer\"><div class=\"t-Form-itemWrapper\"><input type=\"password\" class=\"text_field apex-item-text amc-auth-password amc-auth-strength\" value=\"Xk9#mP2$vL7q\" autocomplete=\"new-password\"></div><span class=\"a-Form-error\"></span></div></div><div class=\"t-Form-fieldContainer apex-item-wrapper\"><div class=\"t-Form-labelContainer\"><label class=\"t-Form-label\">Confirm new password</label></div><div class=\"t-Form-inputContainer\"><div class=\"t-Form-itemWrapper\"><input type=\"password\" class=\"text_field apex-item-text amc-auth-password amc-auth-match\" value=\"Xk9#mP2$vL7q\" autocomplete=\"new-password\"></div><span class=\"a-Form-error\"></span></div></div>",
