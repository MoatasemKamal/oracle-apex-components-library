listTemplate amc-speed-dial (
    name: AMC Speed Dial
    list {
        beforeEntries:
            ```html
            <div class="amc-TSpeedDial #COMPONENT_CSS_CLASSES#" id="#LIST_ID#">
            <details class="amc-TSpeedDial-toggle"><summary class="amc-TSpeedDial-fab"><span class="amc-TSpeedDial-fabText">Quick actions</span><span class="amc-TSpeedDial-fabIcon fa fa-plus" aria-hidden="true"></span></summary></details>
            <ul class="amc-TSpeedDial-list">
            ```
        afterEntries:
            ```html
            </ul>
            </div>
            ```
    }
    entry {
        current:
            ```html
            <li class="amc-TSpeedDial-item is-current"><a class="amc-TSpeedDial-link" href="#LINK#" aria-current="page"><span class="amc-TSpeedDial-label"><span class="amc-TSpeedDial-text">#TEXT#</span><span class="amc-TSpeedDial-hint">#A01#</span></span><span class="amc-TSpeedDial-mini"><span class="amc-TSpeedDial-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span></span></a></li>
            ```
        noncurrent:
            ```html
            <li class="amc-TSpeedDial-item"><a class="amc-TSpeedDial-link" href="#LINK#"><span class="amc-TSpeedDial-label"><span class="amc-TSpeedDial-text">#TEXT#</span><span class="amc-TSpeedDial-hint">#A01#</span></span><span class="amc-TSpeedDial-mini"><span class="amc-TSpeedDial-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span></span></a></li>
            ```
    }
    javaScript {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-speed-dial.js
        ]
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-speed-dial.css
        ]
    }
    attributeDescriptions {
        a01: Hint
    }
    advanced {
        staticId: AMC_TPL_SPEED_DIAL
        translatable: false
    }
    comments {
        comments:
            ```text
            List template for a List region. The entries open from a floating action button: pointer hover opens the dial, a click or tap on the button keeps it open, and keyboard users press Enter or Space on the button and then Tab through the actions. The first entry sits closest to the button. User Defined Attribute 1 is an optional hint under the label, for example 'Ctrl+Alt+N' or '3 drafts'. The button text 'Quick actions' lives in Before List Entry; edit it there to translate it. The optional JavaScript file closes the dial with Escape, on a click outside and when focus leaves it. Template options set the corner (Start corner, Top corner), the direction (Quarter arc), Icon only button and Float on page. By default the region reserves room for the fan; Float on page pins the button to the browser window corner instead. Under reduced motion the dial opens without movement; browsers without CSS trigonometry show the arc as a stack; on touch screens the arc falls back to the stack so labels stay visible.
            ```
    }

    templateOption amc-speed-dial-arc (
        name: Quarter arc
        sequence: 10
        appearance {
            cssClasses: amc-TSpeedDial--arc
        }
        help {
            helpText:
                ```text
                Spreads the actions on a quarter circle around the button; labels appear on hover and focus. Touch screens keep the stack.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: ARC
        }
    )

    templateOption amc-speed-dial-start (
        name: Start corner
        sequence: 20
        appearance {
            cssClasses: amc-TSpeedDial--start
        }
        help {
            helpText:
                ```text
                Places the button in the inline-start corner (left in LTR, right in RTL); the fan opens toward the end.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: START
        }
    )

    templateOption amc-speed-dial-top (
        name: Top corner
        sequence: 30
        appearance {
            cssClasses: amc-TSpeedDial--top
        }
        help {
            helpText:
                ```text
                Places the button at the top and opens the fan downward.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: TOP
        }
    )

    templateOption amc-speed-dial-icon-only (
        name: Icon only button
        sequence: 40
        appearance {
            cssClasses: amc-TSpeedDial--iconOnly
        }
        help {
            helpText:
                ```text
                Round button without the visible text; the text stays available to screen readers.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: ICON_ONLY
        }
    )

    templateOption amc-speed-dial-fixed (
        name: Float on page
        sequence: 50
        appearance {
            cssClasses: amc-TSpeedDial--fixed
        }
        help {
            helpText:
                ```text
                Pins the button to the corner of the browser window above the page and removes the reserved space. Use it once per page, for example on page 0.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: FIXED
        }
    )
)
