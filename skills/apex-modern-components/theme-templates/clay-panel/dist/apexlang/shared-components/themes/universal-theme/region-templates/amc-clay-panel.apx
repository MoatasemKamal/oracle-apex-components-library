regionTemplate amc-clay-panel (
    name: AMC Clay Panel
    region {
        template:
            ```html
            <section class="amc-TClayPanel #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading">
              <header class="amc-TClayPanel-header">
                <span class="amc-TClayPanel-bubble fa #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                <h2 class="amc-TClayPanel-title" id="#REGION_STATIC_ID#_heading">#TITLE#</h2>
                <div class="amc-TClayPanel-actions">#HELP##EDIT##CHANGE##COPY##DELETE##CREATE#</div>
              </header>
              <div class="amc-TClayPanel-body">#BODY##SUB_REGIONS#</div>
              <footer class="amc-TClayPanel-footer">#PREVIOUS##CLOSE##NEXT#</footer>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-clay-panel.css
        ]
    }
    advanced {
        staticId: AMC_TPL_CLAY_PANEL
        translatable: false
    }
    comments {
        comments:
            ```text
            Region template in claymorphism style. Its inner and outer shadows are mixed from the palette color and the page background, so the clay follows the theme and dark styles. The title sits in a raised pill and the region icon in a glossy bubble; the native region sits in a slightly pressed tray with a solid surface so reports and forms stay readable. Help, Edit, Change, Copy, Delete and Create buttons sit in the header, Previous, Close and Next in the footer. Template options tint the clay success, danger, warm or neutral, or remove the tray padding. On hover or focus the panel puffs up and the bubble squishes; under reduced motion nothing moves. In forced-colors mode the shadows are replaced by system borders.
            ```
    }

    templateOption amc-clay-panel-success (
        name: Success clay
        sequence: 10
        appearance {
            cssClasses: amc-TClayPanel--success
        }
        help {
            helpText:
                ```text
                Clay, pill and bubble use the success palette color.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: SUCCESS
        }
    )

    templateOption amc-clay-panel-danger (
        name: Danger clay
        sequence: 20
        appearance {
            cssClasses: amc-TClayPanel--danger
        }
        help {
            helpText:
                ```text
                Clay, pill and bubble use the danger palette color, for alerts that still feel friendly.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: DANGER
        }
    )

    templateOption amc-clay-panel-warm (
        name: Warm clay
        sequence: 30
        appearance {
            cssClasses: amc-TClayPanel--warm
        }
        help {
            helpText:
                ```text
                Warm clay from the warning palette color.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: WARM
        }
    )

    templateOption amc-clay-panel-neutral (
        name: Neutral clay
        sequence: 40
        appearance {
            cssClasses: amc-TClayPanel--neutral
        }
        help {
            helpText:
                ```text
                Uncolored clay mixed from the text and page colors; keeps the icon bubble in the primary color.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NEUTRAL
        }
    )

    templateOption amc-clay-panel-no-body-padding (
        name: No body padding
        sequence: 50
        appearance {
            cssClasses: amc-TClayPanel--noPadding
        }
        help {
            helpText:
                ```text
                Removes padding inside the tray so reports run edge to edge.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_BODY_PADDING
        }
    )
)
