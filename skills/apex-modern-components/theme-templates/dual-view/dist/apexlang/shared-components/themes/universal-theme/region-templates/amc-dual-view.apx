regionTemplate amc-dual-view (
    name: AMC Dual View
    region {
        template:
            ```html
            <section class="amc-TDualView #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading" data-amc-label-caption="%0 by %1" data-amc-label-total="Total" data-amc-label-rows="Rows" data-amc-label-other="Other" data-amc-label-bar="Bar chart" data-amc-label-donut="Donut chart" data-amc-label-first="Showing the first %0 of %1 rows">
              <div class="amc-TDualView-surface">
                <header class="amc-TDualView-header">
                  <span class="amc-TDualView-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                  <h2 class="amc-TDualView-title" id="#REGION_STATIC_ID#_heading">#TITLE#</h2>
                  <div class="amc-TDualView-switch" role="group" aria-label="View as" hidden>
                    <span class="amc-TDualView-thumb" aria-hidden="true"></span>
                    <button type="button" class="amc-TDualView-opt" data-amc-view="table" aria-pressed="true"><span class="amc-TDualView-optIcon fa fa-table" aria-hidden="true"></span><span class="amc-TDualView-optLabel">Table</span></button>
                    <button type="button" class="amc-TDualView-opt" data-amc-view="chart" aria-pressed="false"><span class="amc-TDualView-optIcon amc-TDualView-optIcon--chart fa fa-bar-chart" aria-hidden="true"></span><span class="amc-TDualView-optLabel">Chart</span></button>
                  </div>
                  <div class="amc-TDualView-actions">#HELP##EDIT##CHANGE##COPY##DELETE##CREATE#</div>
                </header>
                <div class="amc-TDualView-stage">
                  <div class="amc-TDualView-body">#BODY##SUB_REGIONS#</div>
                  <figure class="amc-TDualView-chart" hidden></figure>
                </div>
                <footer class="amc-TDualView-footer">#PREVIOUS##CLOSE##NEXT#</footer>
              </div>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    javaScript {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-dual-view.js
        ]
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-dual-view.css
        ]
    }
    advanced {
        staticId: AMC_TPL_DUAL_VIEW
        translatable: false
    }
    comments {
        comments:
            ```text
            Content-aware region template. The script reads the first data table in the region body with textContent, never changing it, and parses numbers locale-safely: group separators, currency prefixes or suffixes, a comma or dot decimal mark by position, negatives and Arabic-Indic digits. Values come from the last numeric column, skipping year and ID columns, or from a region Custom Attribute data-amc-column="Amount" (header text or 1-based position); labels come from the first descriptive text column, skipping code columns such as SO-55120, or from data-amc-label-column. When a table with numbers is found, a Table / Chart switch appears in the header: two buttons with aria-pressed. Chart mode hides the report and draws an SVG chart to scale, redrawn when the region is resized: vertical bars with axis ticks, gridlines, a zero baseline for negative values and value labels, switching by itself to horizontal bars when labels are long, when there are more than 12 rows or when the region is narrow. Values and labels reuse the report's own number format and currency. The chart has role=img with an aria-label listing the values, and a caption with the column names, row count and total; the native table stays in the DOM, hidden in chart mode, and comes back with one click. The chosen view is remembered per application page and region in localStorage; give the region a Static ID. After apexafterrefresh or any change to the body the chart is redrawn. Without a table or without JavaScript there is no switch and the region is a plain frame. English strings to translate: the Table and Chart button labels and the View as group label in the template, and on the section element or per region as Custom Attributes data-amc-label-caption %0 by %1, data-amc-label-total Total, data-amc-label-rows Rows, data-amc-label-other Other, data-amc-label-bar Bar chart, data-amc-label-donut Donut chart, data-amc-label-first Showing the first %0 of %1 rows. Under reduced motion the switch thumb and chart appear without animation; in forced-colors mode marks use Highlight. JavaScript API: amcTplDualView.show(element, 'chart' or 'table'), refresh(element) and data(element).
            ```
    }

    templateOption amc-dual-view-chart-first (
        name: Chart first
        sequence: 10
        appearance {
            cssClasses: amc-TDualView--chartFirst
        }
        help {
            helpText:
                ```text
                Opens in chart mode until the user picks a view; after that the user's choice wins.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: CHART_FIRST
        }
    )

    templateOption amc-dual-view-donut (
        name: Donut
        sequence: 20
        appearance {
            cssClasses: amc-TDualView--donut
        }
        help {
            helpText:
                ```text
                Chart mode draws a donut of each row's share with the total in the centre and a legend with values and percentages. The six largest rows get their own slice and the rest become Other; negative values are left out. Use it for parts of a whole.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: DONUT
        }
    )

    templateOption amc-dual-view-horizontal (
        name: Horizontal bars
        sequence: 30
        appearance {
            cssClasses: amc-TDualView--horizontal
        }
        help {
            helpText:
                ```text
                Always draws horizontal bars, for rankings and long category names. Without it the chart chooses horizontal bars by itself when labels would not fit.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: HORIZONTAL
        }
    )

    templateOption amc-dual-view-sorted (
        name: Sort chart by value
        sequence: 40
        appearance {
            cssClasses: amc-TDualView--sorted
        }
        help {
            helpText:
                ```text
                The chart orders bars from largest to smallest; the report keeps its own order. Leave it off for months or other ordered categories.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: SORTED
        }
    )

    templateOption amc-dual-view-no-body-padding (
        name: No body padding
        sequence: 50
        appearance {
            cssClasses: amc-TDualView--noPadding
        }
        help {
            helpText:
                ```text
                Removes side padding so reports run edge to edge.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_BODY_PADDING
        }
    )
)
