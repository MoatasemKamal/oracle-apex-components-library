regionTemplate amc-glass-depth (
    name: AMC Glass Depth
    region {
        template:
            ```html
            <section class="amc-TGlassDepth #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading">
              <span class="amc-TGlassDepth-backdrop" aria-hidden="true"></span>
              <span class="amc-TGlassDepth-sheet" aria-hidden="true"></span>
              <div class="amc-TGlassDepth-panel">
                <span class="amc-TGlassDepth-glass" aria-hidden="true"></span>
                <header class="amc-TGlassDepth-header">
                  <span class="amc-TGlassDepth-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                  <h2 class="amc-TGlassDepth-title" id="#REGION_STATIC_ID#_heading">#TITLE#</h2>
                  <div class="amc-TGlassDepth-actions">#HELP##EDIT##CHANGE##COPY##DELETE##CREATE#</div>
                </header>
                <div class="amc-TGlassDepth-body">#BODY##SUB_REGIONS#</div>
                <footer class="amc-TGlassDepth-footer">#PREVIOUS##CLOSE##NEXT#</footer>
              </div>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-glass-depth.css
        ]
    }
    advanced {
        staticId: AMC_TPL_GLASS_DEPTH
        translatable: false
    }
    comments {
        comments:
            ```text
            Region template with a floating frosted-glass panel. The frame draws soft palette-colored light behind the panel; the panel blurs it, has a light top edge and a layered depth shadow, and a second glass sheet peeks out underneath. Title and icon sit on the glass; the body keeps an almost opaque surface so reports and forms stay readable. Help, Edit, Change, Copy, Delete and Create buttons sit in the header, Previous, Close and Next in the footer. Template options tint the light with the success, danger or warning palette colors, float the panel higher, or remove the body padding. The light drifts slowly and the panel lifts a little more on hover or focus; under reduced motion everything stays still. In forced-colors mode the glass is replaced by a plain system border.
            ```
    }

    templateOption amc-glass-depth-success-tint (
        name: Success tint
        sequence: 10
        appearance {
            cssClasses: amc-TGlassDepth--success
        }
        help {
            helpText:
                ```text
                Backdrop light uses the success and info palette colors, for healthy or completed states.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: SUCCESS_TINT
        }
    )

    templateOption amc-glass-depth-danger-tint (
        name: Danger tint
        sequence: 20
        appearance {
            cssClasses: amc-TGlassDepth--danger
        }
        help {
            helpText:
                ```text
                Backdrop light uses the danger and warning palette colors, for regions that need attention.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: DANGER_TINT
        }
    )

    templateOption amc-glass-depth-warm-tint (
        name: Warm tint
        sequence: 30
        appearance {
            cssClasses: amc-TGlassDepth--warm
        }
        help {
            helpText:
                ```text
                Warm backdrop light from the warning and primary palette colors.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: WARM_TINT
        }
    )

    templateOption amc-glass-depth-deep-float (
        name: Deep float
        sequence: 40
        appearance {
            cssClasses: amc-TGlassDepth--deep
        }
        help {
            helpText:
                ```text
                More backdrop around the panel, a deeper shadow and two stacked sheets beneath it.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: DEEP_FLOAT
        }
    )

    templateOption amc-glass-depth-no-body-padding (
        name: No body padding
        sequence: 50
        appearance {
            cssClasses: amc-TGlassDepth--noPadding
        }
        help {
            helpText:
                ```text
                Removes the padding inside the body sheet so reports run edge to edge.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_BODY_PADDING
        }
    )
)
