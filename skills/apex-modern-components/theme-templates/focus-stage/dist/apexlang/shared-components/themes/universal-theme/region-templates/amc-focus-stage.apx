regionTemplate amc-focus-stage (
    name: AMC Focus Stage
    region {
        template:
            ```html
            <section class="amc-TFocusStage #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading" data-amc-msg-on="Focus mode on. Press Escape or the Focus button to return to the page." data-amc-msg-off="Focus mode off.">
              <div class="amc-TFocusStage-surface">
                <header class="amc-TFocusStage-header">
                  <span class="amc-TFocusStage-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                  <h2 class="amc-TFocusStage-title" id="#REGION_STATIC_ID#_heading">#TITLE#</h2>
                  <div class="amc-TFocusStage-actions">#HELP##EDIT##CHANGE##COPY##DELETE##CREATE#</div>
                  <button type="button" class="amc-TFocusStage-toggle" aria-pressed="false" aria-describedby="#REGION_STATIC_ID#_heading"><span class="amc-TFocusStage-glyph" aria-hidden="true"></span><span class="amc-TFocusStage-toggleLabel">Focus</span><kbd class="amc-TFocusStage-kbd" aria-hidden="true">Esc</kbd></button>
                </header>
                <div class="amc-TFocusStage-body">#BODY##SUB_REGIONS#</div>
                <footer class="amc-TFocusStage-footer">#PREVIOUS##CLOSE##NEXT#</footer>
              </div>
              <span class="amc-TFocusStage-status" role="status" aria-live="polite"></span>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    javaScript {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-focus-stage.js
        ]
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-focus-stage.css
        ]
    }
    advanced {
        staticId: AMC_TPL_FOCUS_STAGE
        translatable: false
    }
    comments {
        comments:
            ```text
            Living region template (behaviour-aware). A Focus button in the header puts the region on stage: the script adds a page-level scrim to the document body that ignores the pointer, fades and blurs everything outside the region, lifts the region with a ring and deep shadow, and makes its header, with the Focus button, sticky below any fixed page header so it stays reachable in long forms and reports. Focus mode ends with Escape, the Focus button, a click on the dimmed page, or by tabbing onto the dimmed page; focus is never trapped and stays wherever the user put it. Only one region is on stage at a time and nothing is stored. Popups that APEX adds to the page later, such as report menus, date pickers, LOV and modal dialogs, are not dimmed and do not end focus mode; Escape inside an open combobox (aria-expanded true) is left to that control. The region body is never clipped or transformed. The button is a real button with aria-pressed; entering and leaving are announced through a polite live region. Without JavaScript the region is a plain framed region and the Focus button is hidden. Under reduced motion there are no transitions, but the page is still dimmed. Template options: Focus on input enters focus mode as soon as a form field inside the region gets focus, and after Escape waits until focus leaves the region before it can enter again; Deep dim uses a darker scrim and stronger blur; Stage light adds a primary-colored halo around the region on stage; Icon-only button hides the Focus label visually; No body padding runs reports edge to edge. English UI strings to translate in the template: the button label Focus, the key hint Esc, and the data-amc-msg-on and data-amc-msg-off announcements on the region element. Layering: the scrim uses z-index 50 and the region 52, so page headers with a higher z-index stay above the scrim but are dimmed with the rest of the page; if an ancestor of the region forms its own stacking context, the script lifts that ancestor to z-index 51 and dims its other children instead. JavaScript API: amcTplFocusStage.enter(element), amcTplFocusStage.exit(), amcTplFocusStage.active(); a window event amcfocusstage reports each change.
            ```
    }

    templateOption amc-focus-stage-auto-focus (
        name: Focus on input
        sequence: 10
        appearance {
            cssClasses: amc-TFocusStage--auto
        }
        help {
            helpText:
                ```text
                Enters focus mode automatically when a text field, select list or text area inside the region gets focus. Escape or the Focus button leaves it; it can enter again after focus has left the region.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: AUTO_FOCUS
        }
    )

    templateOption amc-focus-stage-deep-dim (
        name: Deep dim
        sequence: 20
        appearance {
            cssClasses: amc-TFocusStage--deep
        }
        help {
            helpText:
                ```text
                A darker scrim and a stronger blur on the rest of the page, for busy dashboards.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: DEEP_DIM
        }
    )

    templateOption amc-focus-stage-stage-light (
        name: Stage light
        sequence: 30
        appearance {
            cssClasses: amc-TFocusStage--spotlight
        }
        help {
            helpText:
                ```text
                Adds a soft halo in the primary color around the region while it is on stage.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: STAGE_LIGHT
        }
    )

    templateOption amc-focus-stage-icon-only (
        name: Icon-only button
        sequence: 40
        appearance {
            cssClasses: amc-TFocusStage--iconOnly
        }
        help {
            helpText:
                ```text
                Shows only the focus glyph in the header; the label stays available to screen readers. For narrow regions.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: ICON_ONLY
        }
    )

    templateOption amc-focus-stage-no-body-padding (
        name: No body padding
        sequence: 50
        appearance {
            cssClasses: amc-TFocusStage--noPadding
        }
        help {
            helpText:
                ```text
                Removes side padding so reports and grids run edge to edge.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_BODY_PADDING
        }
    )
)
