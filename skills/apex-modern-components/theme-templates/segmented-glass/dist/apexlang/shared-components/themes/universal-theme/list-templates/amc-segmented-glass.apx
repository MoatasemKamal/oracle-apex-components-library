listTemplate amc-segmented-glass (
    name: AMC Segmented Glass
    list {
        beforeEntries:
            ```html
            <div class="amc-TSegmentedGlass #COMPONENT_CSS_CLASSES#" id="#LIST_ID#">
            <div class="amc-TSegmentedGlass-scroller">
            <div class="amc-TSegmentedGlass-track">
            <span class="amc-TSegmentedGlass-thumb" aria-hidden="true"></span>
            <ul class="amc-TSegmentedGlass-list">
            ```
        afterEntries:
            ```html
            </ul>
            </div>
            </div>
            </div>
            ```
    }
    entry {
        current:
            ```html
            <li class="amc-TSegmentedGlass-item is-current"><a class="amc-TSegmentedGlass-link" href="#LINK#" aria-current="page" data-label="#TEXT_ESC_SC#"><span class="amc-TSegmentedGlass-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span><span class="amc-TSegmentedGlass-label">#TEXT#</span></a></li>
            ```
        noncurrent:
            ```html
            <li class="amc-TSegmentedGlass-item"><a class="amc-TSegmentedGlass-link" href="#LINK#" data-label="#TEXT_ESC_SC#"><span class="amc-TSegmentedGlass-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span><span class="amc-TSegmentedGlass-label">#TEXT#</span></a></li>
            ```
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-segmented-glass.css
        ]
    }
    advanced {
        staticId: AMC_TPL_SEGMENTED_GLASS
        translatable: false
    }
    comments {
        comments:
            ```text
            List template for view switching and page-level navigation. Each entry is a real link with icon and label; the current entry gets aria-current=page. Segments share one width, and a raised glass thumb marks the current page and slides to the hovered or keyboard-focused segment without JavaScript. Lists longer than eight entries, and browsers without :has(), keep a static glass thumb on the current segment. The control scrolls horizontally when it is wider than its container. Template options: Icon only hides the labels visually, keeps them for screen readers and shows them as a tooltip on hover and focus; Stacked puts the icon above the label; Primary thumb fills the thumb with the primary color; Stretch spans the full width; Large raises the height. Under prefers-reduced-motion the thumb jumps without sliding; in forced-colors mode the current segment gets a system outline.
            ```
    }

    templateOption amc-segmented-glass-icon-only (
        name: Icon only
        sequence: 10
        appearance {
            cssClasses: amc-TSegmentedGlass--iconOnly
        }
        help {
            helpText:
                ```text
                Shows only icons; the label stays available to screen readers and appears as a tooltip on hover and keyboard focus. Every entry needs an icon.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: ICON_ONLY
        }
    )

    templateOption amc-segmented-glass-stacked (
        name: Stacked icon and label
        sequence: 20
        appearance {
            cssClasses: amc-TSegmentedGlass--stacked
        }
        help {
            helpText:
                ```text
                Places the icon above a smaller label, like an app tab bar.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: STACKED
        }
    )

    templateOption amc-segmented-glass-primary (
        name: Primary thumb
        sequence: 30
        appearance {
            cssClasses: amc-TSegmentedGlass--primary
        }
        help {
            helpText:
                ```text
                The glass thumb takes the primary color and the segment on it switches to the primary contrast color.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: PRIMARY
        }
    )

    templateOption amc-segmented-glass-stretch (
        name: Stretch
        sequence: 40
        appearance {
            cssClasses: amc-TSegmentedGlass--stretch
        }
        help {
            helpText:
                ```text
                The control spans the full width of the region with equal segments.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: STRETCH
        }
    )

    templateOption amc-segmented-glass-large (
        name: Large
        sequence: 50
        appearance {
            cssClasses: amc-TSegmentedGlass--large
        }
        help {
            helpText:
                ```text
                Taller segments with larger text and icons, for page headers and touch screens.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: LARGE
        }
    )
)
