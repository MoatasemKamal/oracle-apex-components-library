regionTemplate amc-empty-aware (
    name: AMC Empty Aware
    region {
        template:
            ```html
            <section class="amc-TEmptyAware #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading" data-amc-text-fallback="Nothing to show" data-amc-text-restored="%0 updated">
              <div class="amc-TEmptyAware-surface">
                <header class="amc-TEmptyAware-header">
                  <span class="amc-TEmptyAware-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                  <h2 class="amc-TEmptyAware-title" id="#REGION_STATIC_ID#_heading">#TITLE#</h2>
                  <div class="amc-TEmptyAware-actions">#HELP##EDIT##CHANGE##COPY#<span class="amc-TEmptyAware-create">#CREATE#</span></div>
                </header>
                <div class="amc-TEmptyAware-stage">
                  <div class="amc-TEmptyAware-body">#BODY#</div>
                  <div class="amc-TEmptyAware-empty" hidden>
                    <svg class="amc-TEmptyAware-art amc-TEmptyAware-art--tray" viewBox="0 0 160 120" aria-hidden="true" focusable="false"><ellipse class="amc-TEmptyAware-artGround" cx="80" cy="108" rx="58" ry="7"/><rect class="amc-TEmptyAware-artFill" x="56" y="10" width="48" height="34" rx="6"/><path class="amc-TEmptyAware-artLine" d="M65 22 H95 M65 31 H84"/><path class="amc-TEmptyAware-artFill" d="M28 72 L48 46 H112 L132 72 V94 C132 98 129 101 125 101 H35 C31 101 28 98 28 94 Z"/><path class="amc-TEmptyAware-artLine" d="M28 72 L48 46 H112 L132 72 V94 C132 98 129 101 125 101 H35 C31 101 28 98 28 94 Z M28 72 H58 C58 78 62 82 68 82 H92 C98 82 102 78 102 72 H132"/></svg>
                    <svg class="amc-TEmptyAware-art amc-TEmptyAware-art--search" viewBox="0 0 160 120" aria-hidden="true" focusable="false"><ellipse class="amc-TEmptyAware-artGround" cx="80" cy="108" rx="58" ry="7"/><rect class="amc-TEmptyAware-artFill" x="30" y="18" width="84" height="12" rx="6"/><rect class="amc-TEmptyAware-artFill" x="30" y="38" width="60" height="12" rx="6"/><circle class="amc-TEmptyAware-artFill" cx="96" cy="62" r="24"/><path class="amc-TEmptyAware-artLine" d="M96 38 A24 24 0 1 1 95.9 38 Z M113 79 L132 98"/><path class="amc-TEmptyAware-artLine amc-TEmptyAware-artThick" d="M113 79 L132 98"/><path class="amc-TEmptyAware-artLine" d="M86 62 H106"/></svg>
                    <svg class="amc-TEmptyAware-art amc-TEmptyAware-art--docs" viewBox="0 0 160 120" aria-hidden="true" focusable="false"><ellipse class="amc-TEmptyAware-artGround" cx="80" cy="108" rx="58" ry="7"/><rect class="amc-TEmptyAware-artFill" x="40" y="22" width="54" height="70" rx="7" transform="rotate(-8 67 57)"/><path class="amc-TEmptyAware-artLine" d="M40 22 h54 v70 h-54 Z" transform="rotate(-8 67 57)"/><rect class="amc-TEmptyAware-artPaper" x="62" y="18" width="54" height="72" rx="7"/><path class="amc-TEmptyAware-artLine" d="M69 18 H109 A7 7 0 0 1 116 25 V83 A7 7 0 0 1 109 90 H69 A7 7 0 0 1 62 83 V25 A7 7 0 0 1 69 18 Z M72 34 H104 M72 44 H104 M72 54 H92"/><circle class="amc-TEmptyAware-artAccent" cx="116" cy="88" r="13"/><path class="amc-TEmptyAware-artPlus" d="M116 81 V95 M109 88 H123"/></svg>
                    <div class="amc-TEmptyAware-emptyText">
                      <p class="amc-TEmptyAware-emptyTitle"></p>
                      <p class="amc-TEmptyAware-emptyHint" hidden></p>
                      <div class="amc-TEmptyAware-emptyAction"></div>
                    </div>
                  </div>
                </div>
                <div class="amc-TEmptyAware-more">#SUB_REGIONS#</div>
                <footer class="amc-TEmptyAware-footer">#PREVIOUS##CLOSE##DELETE##NEXT#</footer>
                <p class="amc-TEmptyAware-live" role="status" aria-live="polite"></p>
              </div>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    javaScript {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-empty-aware.js
        ]
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-empty-aware.css
        ]
    }
    advanced {
        staticId: AMC_TPL_EMPTY_AWARE
        translatable: false
    }
    comments {
        comments:
            ```text
            Content-aware region template for regions that can be empty. With the script it checks the region body on load, after apexafterrefresh and whenever the body changes. The region is empty when it has no data rows in any table and no cards in any card list, and it shows an APEX no-data message (Classic Report nodatafound, Interactive Report a-IRR-noDataMsg, Interactive Grid a-GV-noDataMsg, or any element whose class names no data; mark your own with data-amc-no-data), a table with headers but no rows, an empty card list (a list whose class contains Cards or CardView, or one marked data-amc-cards), or no content at all. The no-data message and header-only tables are hidden while the empty state shows and come back on restore; search bars, filters and other controls stay visible so a filtered search can be changed. When nothing native is left the body collapses.
            PRINCIPLES APPLIED. Figure-ground: the empty state is the figure, a drawing with a strong outline, a short high-contrast message and one button, on a quiet dotted ground that fades out, so the eye lands on what to do instead of a thin grey line of text. Feedback patterns: the change is announced politely, the empty message on becoming empty and '<region title> updated' when rows return, and the next action is placed at the point of need, never color-only.
            THE EMPTY STATE. Message: the Custom Attribute data-amc-empty-title if set, otherwise the text of the region's own no-data message, so the When No Data Found text of a report is reused, otherwise data-amc-text-fallback, Nothing to show. Hint: data-amc-empty-hint, optional, one sentence on why it is empty or what fills it. Action: the button in the region's Create position moves from the header into the empty state and moves back when rows return, keeping focus if it had it; its label, action and authorization stay native. Write the Create label as the action, for example New purchase request.
            STRINGS to translate, on the section element in the template or per region as Custom Attributes: data-amc-text-fallback "Nothing to show", data-amc-text-restored "%0 updated" where %0 is the region title; per region data-amc-empty-title and data-amc-empty-hint.
            MOTION AND ACCESSIBILITY. The empty state fades in over 0.24s when it appears, and not at all under reduced motion. The drawings are decorative and hidden from assistive technology; forced-colors mode draws them in system colors with a border around the empty state. Without JavaScript the region is a plain frame showing the native no-data message. The native markup is never rewritten; the script only adds and removes the attribute data-amc-empty-hidden. The APEX class names for no-data messages must be confirmed on your release; add data-amc-no-data to a custom message if needed. JavaScript API: amcTplEmptyAware.refresh(element), isEmpty(element) and reload(element).
            ```
    }

    templateOption amc-empty-aware-art-search (
        name: Drawing - Search
        sequence: 10
        appearance {
            cssClasses: amc-TEmptyAware--search
        }
        help {
            helpText:
                ```text
                A magnifier over result lines, for searches and filtered reports where empty means nothing matched. Leave the drawings unticked for the default tray, which suits lists that are simply empty.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: ART_SEARCH
        }
    )

    templateOption amc-empty-aware-art-docs (
        name: Drawing - Documents
        sequence: 20
        appearance {
            cssClasses: amc-TEmptyAware--docs
        }
        help {
            helpText:
                ```text
                Stacked sheets with a plus badge, for document, attachment and file lists that are filled by uploading.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: ART_DOCS
        }
    )

    templateOption amc-empty-aware-compact (
        name: Compact
        sequence: 30
        appearance {
            cssClasses: amc-TEmptyAware--compact
        }
        help {
            helpText:
                ```text
                A smaller drawing beside the message in one short row, for dashboard tiles and side columns where a tall empty state would push other content away.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: COMPACT
        }
    )

    templateOption amc-empty-aware-dashed (
        name: Dashed outline
        sequence: 40
        appearance {
            cssClasses: amc-TEmptyAware--dashed
        }
        help {
            helpText:
                ```text
                A dashed outline instead of the tinted ground marks the empty state as a space to be filled, for upload and drop areas.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: DASHED
        }
    )

    templateOption amc-empty-aware-frameless (
        name: Frameless
        sequence: 50
        appearance {
            cssClasses: amc-TEmptyAware--frameless
        }
        help {
            helpText:
                ```text
                No card of its own and no side padding, for regions placed inside another frame such as a dashboard island or a tab.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: FRAMELESS
        }
    )
)
