regionTemplate amc-holo-edge (
    name: AMC Holo Edge
    region {
        template:
            ```html
            <section class="amc-THoloEdge #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading">
              <header class="amc-THoloEdge-header">
                <span class="amc-THoloEdge-strip" aria-hidden="true"></span>
                <span class="amc-THoloEdge-chip fa #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                <h2 class="amc-THoloEdge-title" id="#REGION_STATIC_ID#_heading">#TITLE#</h2>
                <div class="amc-THoloEdge-actions">#HELP##EDIT##CHANGE##COPY##DELETE##CREATE#</div>
              </header>
              <div class="amc-THoloEdge-body">#BODY##SUB_REGIONS#</div>
              <footer class="amc-THoloEdge-footer">#PREVIOUS##CLOSE##NEXT#</footer>
              <span class="amc-THoloEdge-foil" aria-hidden="true"></span>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    javaScript {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-holo-edge.js
        ]
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-holo-edge.css
        ]
    }
    advanced {
        staticId: AMC_TPL_HOLO_EDGE
        translatable: false
    }
    comments {
        comments:
            ```text
            Region template with a holographic foil edge and header strip. The foil is a repeating gradient of the theme palette colors, softened toward the surface color so the title stays readable; a fine diagonal texture and a glint sit on top. The sheen follows the mouse over the region and drifts slowly otherwise; keyboard focus shifts it as well. The body is a plain surface. Help, Edit, Change, Copy, Delete and Create buttons sit in the header, Previous, Close and Next in the footer. Template options thicken the edge, switch to a brand foil in primary and info tones or a sunset foil in danger and warning tones, stop the drift, or remove the body padding. Without JavaScript the foil still drifts; under reduced motion it stays still. In forced-colors mode the foil is replaced by a system border.
            ```
    }

    templateOption amc-holo-edge-thick-edge (
        name: Thick edge
        sequence: 10
        appearance {
            cssClasses: amc-THoloEdge--thick
        }
        help {
            helpText:
                ```text
                A 5px foil edge and a taller header strip, for a single hero region.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: THICK_EDGE
        }
    )

    templateOption amc-holo-edge-brand-foil (
        name: Brand foil
        sequence: 20
        appearance {
            cssClasses: amc-THoloEdge--brand
        }
        help {
            helpText:
                ```text
                Foil in primary and info tones only, for on-brand pages.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: BRAND_FOIL
        }
    )

    templateOption amc-holo-edge-sunset-foil (
        name: Sunset foil
        sequence: 30
        appearance {
            cssClasses: amc-THoloEdge--sunset
        }
        help {
            helpText:
                ```text
                Warm foil from the danger, warning and primary palette colors.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: SUNSET_FOIL
        }
    )

    templateOption amc-holo-edge-static-foil (
        name: Static foil
        sequence: 40
        appearance {
            cssClasses: amc-THoloEdge--static
        }
        help {
            helpText:
                ```text
                Stops the slow drift; the sheen moves only with the pointer.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: STATIC_FOIL
        }
    )

    templateOption amc-holo-edge-no-body-padding (
        name: No body padding
        sequence: 50
        appearance {
            cssClasses: amc-THoloEdge--noPadding
        }
        help {
            helpText:
                ```text
                Removes side padding so reports run edge to edge.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_BODY_PADDING
        }
    )
)
