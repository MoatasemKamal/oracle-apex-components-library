regionTemplate amc-kinetic-title (
    name: AMC Kinetic Title
    region {
        template:
            ```html
            <section class="amc-TKineticTitle #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading">
              <header class="amc-TKineticTitle-header">
                <span class="amc-TKineticTitle-ghost" aria-hidden="true">#TITLE#</span>
                <div class="amc-TKineticTitle-kicker">
                  <span class="amc-TKineticTitle-eyebrow" aria-hidden="true"><span class="amc-TKineticTitle-icon fa #ICON_CSS_CLASSES#"></span><span class="amc-TKineticTitle-tick"></span></span>
                  <div class="amc-TKineticTitle-actions">#HELP##EDIT##CHANGE##COPY##DELETE##CREATE#</div>
                </div>
                <h2 class="amc-TKineticTitle-title" id="#REGION_STATIC_ID#_heading"><span class="amc-TKineticTitle-ink">#TITLE#</span></h2>
                <span class="amc-TKineticTitle-rule" aria-hidden="true"></span>
              </header>
              <div class="amc-TKineticTitle-sheet">
                <div class="amc-TKineticTitle-body">#BODY##SUB_REGIONS#</div>
                <footer class="amc-TKineticTitle-footer">#PREVIOUS##CLOSE##NEXT#</footer>
              </div>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-kinetic-title.css
        ]
    }
    advanced {
        staticId: AMC_TPL_KINETIC_TITLE
        translatable: false
    }
    comments {
        comments:
            ```text
            Region template with oversized kinetic type. The region title is set very large as outlined letters; when the pointer is over the region or anything inside it has keyboard focus, color wipes into the letters from the reading start edge and the accent on the rule grows. The region icon is a small eyebrow above the title; buttons in Help, Edit, Change, Copy, Delete and Create sit at the end of the eyebrow line and Previous, Close and Next in the footer. The native content sits on a plain surface sheet below the rule. Template options: Giant ghost title repeats the title huge and faint behind the header, Solid title starts filled in the text color and wipes to the accent color, Huge title makes it larger still, Ink fill wipes in the text color instead of the palette gradient, and No body padding. Short titles work best; long titles wrap. Under reduced motion the fill changes without the wipe; in forced-colors mode the title is plain solid text.
            ```
    }

    templateOption amc-kinetic-title-ghost (
        name: Giant ghost title
        sequence: 10
        appearance {
            cssClasses: amc-TKineticTitle--ghost
        }
        help {
            helpText:
                ```text
                Repeats the title very large and faint behind the header, cropped by the header, which drifts a little on hover.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: GHOST
        }
    )

    templateOption amc-kinetic-title-solid (
        name: Solid title
        sequence: 20
        appearance {
            cssClasses: amc-TKineticTitle--solid
        }
        help {
            helpText:
                ```text
                The title starts filled in the text color instead of outlined, for maximum legibility; the hover wipe paints the accent color.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: SOLID
        }
    )

    templateOption amc-kinetic-title-huge (
        name: Huge title
        sequence: 30
        appearance {
            cssClasses: amc-TKineticTitle--huge
        }
        help {
            helpText:
                ```text
                Makes the title larger still, for the first region of a page. Keep the title to a few words.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: HUGE
        }
    )

    templateOption amc-kinetic-title-ink-fill (
        name: Ink fill
        sequence: 40
        appearance {
            cssClasses: amc-TKineticTitle--inkFill
        }
        help {
            helpText:
                ```text
                The wipe fills the letters with the text color instead of the primary palette gradient.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: INK_FILL
        }
    )

    templateOption amc-kinetic-title-no-body-padding (
        name: No body padding
        sequence: 50
        appearance {
            cssClasses: amc-TKineticTitle--noPadding
        }
        help {
            helpText:
                ```text
                Removes side padding of the content sheet so reports run edge to edge.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_BODY_PADDING
        }
    )
)
