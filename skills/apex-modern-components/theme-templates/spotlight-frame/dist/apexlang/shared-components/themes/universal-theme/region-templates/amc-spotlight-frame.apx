regionTemplate amc-spotlight-frame (
    name: AMC Spotlight Frame
    region {
        template:
            ```html
            <section class="amc-TSpotlightFrame #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading">
              <span class="amc-TSpotlightFrame-light" aria-hidden="true"></span>
              <header class="amc-TSpotlightFrame-header">
                <span class="amc-TSpotlightFrame-grid" aria-hidden="true"></span>
                <span class="amc-TSpotlightFrame-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                <h2 class="amc-TSpotlightFrame-title" id="#REGION_STATIC_ID#_heading">#TITLE#</h2>
                <div class="amc-TSpotlightFrame-actions">#HELP##EDIT##CHANGE##COPY##DELETE##CREATE#</div>
              </header>
              <div class="amc-TSpotlightFrame-body">#BODY##SUB_REGIONS#</div>
              <footer class="amc-TSpotlightFrame-footer">#PREVIOUS##CLOSE##NEXT#</footer>
              <span class="amc-TSpotlightFrame-rim" aria-hidden="true"></span>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    javaScript {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-spotlight-frame.js
        ]
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-spotlight-frame.css
        ]
    }
    advanced {
        staticId: AMC_TPL_SPOTLIGHT_FRAME
        translatable: false
    }
    comments {
        comments:
            ```text
            Region template with a pointer spotlight. Title and icon come from the region; Help, Edit, Change, Copy, Delete and Create buttons sit in the header, Previous, Close and Next in the footer. The border lights up where the mouse is, a soft light follows it across the frame, and a faint grid appears inside the light in the header. Keyboard focus moves the light to the focused field. Without JavaScript, on touch screens and under reduced motion the light rests in the top start corner and does not move. Template options change the light color to success or danger, widen the light, swap the header grid for dots, or remove the body padding for edge-to-edge reports. In forced-colors mode the frame becomes a plain system border.
            ```
    }

    templateOption amc-spotlight-frame-success (
        name: Success light
        sequence: 10
        appearance {
            cssClasses: amc-TSpotlightFrame--success
        }
        help {
            helpText:
                ```text
                Border glow and light use the success palette color.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: SUCCESS
        }
    )

    templateOption amc-spotlight-frame-danger (
        name: Danger light
        sequence: 20
        appearance {
            cssClasses: amc-TSpotlightFrame--danger
        }
        help {
            helpText:
                ```text
                Border glow and light use the danger and warning palette colors, for escalations and exceptions.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: DANGER
        }
    )

    templateOption amc-spotlight-frame-wide (
        name: Wide light
        sequence: 30
        appearance {
            cssClasses: amc-TSpotlightFrame--wide
        }
        help {
            helpText:
                ```text
                A larger, softer spotlight for big regions such as full-width reports and charts.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: WIDE
        }
    )

    templateOption amc-spotlight-frame-dots (
        name: Dot pattern
        sequence: 40
        appearance {
            cssClasses: amc-TSpotlightFrame--dots
        }
        help {
            helpText:
                ```text
                Replaces the header grid with a dot pattern that appears inside the light.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: DOTS
        }
    )

    templateOption amc-spotlight-frame-no-body-padding (
        name: No body padding
        sequence: 50
        appearance {
            cssClasses: amc-TSpotlightFrame--noPadding
        }
        help {
            helpText:
                ```text
                Removes side padding so reports and grids run edge to edge.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_BODY_PADDING
        }
    )
)
