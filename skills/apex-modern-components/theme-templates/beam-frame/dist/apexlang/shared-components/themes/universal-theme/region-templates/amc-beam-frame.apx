regionTemplate amc-beam-frame (
    name: AMC Beam Frame
    region {
        template:
            ```html
            <section class="amc-TBeamFrame #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading">
              <span class="amc-TBeamFrame-beam" aria-hidden="true"></span>
              <div class="amc-TBeamFrame-surface">
                <header class="amc-TBeamFrame-header">
                  <span class="amc-TBeamFrame-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span>
                  <h2 class="amc-TBeamFrame-title" id="#REGION_STATIC_ID#_heading">#TITLE#</h2>
                  <div class="amc-TBeamFrame-actions">#HELP##EDIT##CHANGE##COPY##DELETE##CREATE#</div>
                </header>
                <div class="amc-TBeamFrame-body">#BODY##SUB_REGIONS#</div>
                <footer class="amc-TBeamFrame-footer">#PREVIOUS##CLOSE##NEXT#</footer>
              </div>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-beam-frame.css
        ]
    }
    advanced {
        staticId: AMC_TPL_BEAM_FRAME
        translatable: false
    }
    comments {
        comments:
            ```text
            Region template with a travelling border beam. Title and icon come from the region; buttons in Help, Edit, Change, Copy, Delete and Create sit in the header, and Previous, Close and Next in the footer. Template options add a second beam, success or danger colors, a slower beam, no body padding or a visually hidden header. Under reduced motion the beam stops as a static gradient border; in forced-colors mode the frame becomes a plain system border.
            ```
    }

    templateOption amc-beam-frame-dual-beam (
        name: Dual beam
        sequence: 10
        appearance {
            cssClasses: amc-TBeamFrame--dual
        }
        help {
            helpText:
                ```text
                Two beams chase each other around the border.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: DUAL_BEAM
        }
    )

    templateOption amc-beam-frame-success (
        name: Success color
        sequence: 20
        appearance {
            cssClasses: amc-TBeamFrame--success
        }
        help {
            helpText:
                ```text
                Beam and icon use the success palette color.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: SUCCESS
        }
    )

    templateOption amc-beam-frame-danger (
        name: Danger color
        sequence: 30
        appearance {
            cssClasses: amc-TBeamFrame--danger
        }
        help {
            helpText:
                ```text
                Beam and icon use the danger and warning palette colors, for escalations.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: DANGER
        }
    )

    templateOption amc-beam-frame-slow (
        name: Slow beam
        sequence: 40
        appearance {
            cssClasses: amc-TBeamFrame--slow
        }
        help {
            helpText:
                ```text
                Halves the beam speed for calmer pages.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: SLOW
        }
    )

    templateOption amc-beam-frame-no-body-padding (
        name: No body padding
        sequence: 50
        appearance {
            cssClasses: amc-TBeamFrame--noPadding
        }
        help {
            helpText:
                ```text
                Removes side padding so reports and grids run edge to edge.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_BODY_PADDING
        }
    )

    templateOption amc-beam-frame-hide-header (
        name: Hide header
        sequence: 60
        appearance {
            cssClasses: amc-TBeamFrame--hideHeader
        }
        help {
            helpText:
                ```text
                Keeps the title for screen readers but hides the header visually.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: HIDE_HEADER
        }
    )
)
