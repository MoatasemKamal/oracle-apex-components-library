regionTemplate amc-collapsible-morph (
    name: AMC Collapsible Morph
    region {
        template:
            ```html
            <section class="amc-TCollapsibleMorph #REGION_CSS_CLASSES#" id="#REGION_STATIC_ID#" #REGION_ATTRIBUTES# aria-labelledby="#REGION_STATIC_ID#_heading">
              <div class="amc-TCollapsibleMorph-shell">
                <header class="amc-TCollapsibleMorph-header">
                  <h2 class="amc-TCollapsibleMorph-title" id="#REGION_STATIC_ID#_heading">
                    <button type="button" class="amc-TCollapsibleMorph-toggle" aria-expanded="true" aria-controls="#REGION_STATIC_ID#_body"><span class="amc-TCollapsibleMorph-icon fa #ICON_CSS_CLASSES#" aria-hidden="true"></span><span class="amc-TCollapsibleMorph-label">#TITLE#</span><span class="amc-TCollapsibleMorph-chevron" aria-hidden="true"></span></button>
                  </h2>
                  <div class="amc-TCollapsibleMorph-actions">#HELP##EDIT##CHANGE##COPY##DELETE##CREATE#</div>
                </header>
                <div class="amc-TCollapsibleMorph-body" id="#REGION_STATIC_ID#_body">
                  <div class="amc-TCollapsibleMorph-clip">
                    <div class="amc-TCollapsibleMorph-content">#BODY##SUB_REGIONS#</div>
                    <footer class="amc-TCollapsibleMorph-footer">#PREVIOUS##CLOSE##NEXT#</footer>
                  </div>
                </div>
              </div>
            </section>
            ```
    }
    accessibility {
        landmarkType: region
    }
    javaScript {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-collapsible-morph.js
        ]
    }
    css {
        fileUrls: [
            #APP_FILES#amc-templates/amc-tpl-collapsible-morph.css
        ]
    }
    advanced {
        staticId: AMC_TPL_COLLAPSIBLE_MORPH
        translatable: false
    }
    comments {
        comments:
            ```text
            Collapsible region template. The region title is a button with aria-expanded and aria-controls inside the heading; clicking it or pressing Enter or Space collapses the card into a pill that holds only the icon, title and chevron, and expands it again. The body is clipped only while it is collapsed or animating and is hidden from keyboard and screen readers when collapsed; when open it is never clipped, so report menus, date pickers and popups inside work normally. After expanding, a resize event lets charts redraw. Without JavaScript the region renders expanded and cannot collapse. Buttons in Help, Edit, Change, Copy, Delete and Create sit in the header and hide while collapsed; Previous, Close and Next sit in the footer. Template options: Collapsed by default applies on page load; Remember state keeps the collapsed or expanded state per page and region for the browser session; Pill at end places the collapsed pill at the inline end; Primary pill colors the collapsed pill with the primary color; No body padding. Under prefers-reduced-motion the change is instant; JavaScript API: amcTplCollapsibleMorph.collapse(element) and expand(element).
            ```
    }

    templateOption amc-collapsible-morph-collapsed (
        name: Collapsed by default
        sequence: 10
        appearance {
            cssClasses: amc-TCollapsibleMorph--collapsed
        }
        help {
            helpText:
                ```text
                The region starts as a pill. Applied by the template script on page load; without JavaScript the region stays expanded so its content is never lost.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: COLLAPSED
        }
    )

    templateOption amc-collapsible-morph-remember (
        name: Remember state
        sequence: 20
        appearance {
            cssClasses: amc-TCollapsibleMorph--remember
        }
        help {
            helpText:
                ```text
                Keeps the collapsed or expanded state per page and region for the browser session. Needs a region Static ID.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: REMEMBER
        }
    )

    templateOption amc-collapsible-morph-pill-end (
        name: Pill at end
        sequence: 30
        appearance {
            cssClasses: amc-TCollapsibleMorph--pillEnd
        }
        help {
            helpText:
                ```text
                When collapsed, the pill sits at the inline end of the row, for toolbars and side filters.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: PILL_END
        }
    )

    templateOption amc-collapsible-morph-primary (
        name: Primary pill
        sequence: 40
        appearance {
            cssClasses: amc-TCollapsibleMorph--primary
        }
        help {
            helpText:
                ```text
                The collapsed pill takes the primary color, so a collapsed section stands out as a call to open it.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: PRIMARY
        }
    )

    templateOption amc-collapsible-morph-no-body-padding (
        name: No body padding
        sequence: 50
        appearance {
            cssClasses: amc-TCollapsibleMorph--noPadding
        }
        help {
            helpText:
                ```text
                Removes side padding so reports and grids run edge to edge.
                ```
        }
        advanced {
            isAdvancedOption: false
            staticId: NO_BODY_PADDING
        }
    )
)
